	for k2 in keep: GS.set(k2, keep[k2])
	main.launch()
	await _until(func(): return main.state == "flight", 8.0)
	_sp().set_player_model()
	_sp().controls = true

## v1.9x (owner's HANGAR layout): WEAPONS & GEAR fills the screen: frame (level) select, the blueprint with its slots,
## SLOT INFO, a shop grid with filters, the frame's specs; the mech blueprint shows the same slots (arms = wings).
## v3.5 (owner): every page stands you in a 360 room (Liberator's are in): the top bar, a left window, the page in a
## right window, HIDE PANELS to look round; drag looks round; the lounge lists who is here.
## v9.2 (owner): dock where they are HOSTILE to you: the alarm, no launching, Evee stays away, and a cover fight in
## each room to the hangar (five soldiers and a squad leader); duck or side-step to dodge, the sight fires on its own.
## v11.15 (owner): Orion's lockdown: every guard is its helmeted soldier; one boss, the marshal with a blade, only at the hangar.
func _breakout_orion_check() -> void:
	var probe := Breakout.new()
	probe.faction = "orion"
	probe.rooms = Data.BREAKOUT_ROOMS.duplicate()
	probe._load_cast()
	var art: Dictionary = Data.BREAKOUT_ART["orion"]
	var guard_tex: Texture2D = load(str(art["guard"]))
	var guards_ok: bool = probe.cast.size() >= 6 and probe.cast.keys().all(func(k): return int(k) == Data.BREAKOUT_FINAL_LEADER or (probe.cast[k]["full"] as Texture2D).get_size() == guard_tex.get_size())
	var boss_ok: bool = str(probe.cast[Data.BREAKOUT_FINAL_LEADER]["name"]) == str(art["boss_name"]) and probe.cast[Data.BREAKOUT_FINAL_LEADER]["full"] != null
	probe.room_i = 0
	probe.wave_i = probe.waves().size() - 1
	probe.queue = []
	probe.enemies = []
	probe._waves_step()
	var no_mid_boss: bool = probe.state == "clear" and not probe.boss_out
	probe.room_i = probe.rooms.size() - 1
	probe.state = "fight"
	probe.wave_i = probe.waves().size() - 1
	probe._waves_step()
	var hangar_boss: bool = probe.boss_out and probe.enemies.size() == 1 and bool(probe.enemies[0]["boss"])
	var anim_ok: bool = not probe.sheet("guard_idle").is_empty() and not probe.sheet("guard_shoot").is_empty() and not probe.sheet("guard_fall").is_empty() \
		and not probe.sheet("boss_blade").is_empty() and str(probe.anim_of({"boss": false, "hp": 1, "state": "fire"})[0]) == "guard_shoot" \
		and str(probe.anim_of({"boss": true, "hp": 1, "state": "rush"})[0]) == "boss_blade" and str(probe.anim_of({"boss": false, "hp": 0, "state": "patrol"})[0]) == "guard_fall" \
		and str(probe.anim_of({"boss": false, "hp": 1, "state": "run"})[0]) == "guard_run" and str(probe.anim_of({"boss": false, "hp": 1, "state": "advance"})[0]) == "guard_charge" \
		and str(probe.anim_of({"boss": true, "hp": 1, "state": "enter"})[0]) == "boss_run" \
		and str(probe.anim_of({"boss": false, "hp": 0, "state": "patrol", "head": true})[0]) == "guard_fall_head"
	# v11.19 (owner): the LAYERS fight: they step up layer by layer, bolts you dodge, caught at the front
	probe.enemies = []
	probe.bolts = []
	probe.hp = 100.0
	var lg: Dictionary = probe._spawn(1, 0, false, true)
	var start_back: bool = probe.layered() and float(lg["depth"]) == 0.0 and int(lg["layer"]) == 0
	lg["state"] = "advance"
	lg["from_d"] = 0.67
	lg["from_x"] = 0.5
	lg["layer"] = 3
	lg["goal"] = 0.5
	lg["adv"] = 0.0
	for i in 40: probe._update_layers(0.05)
	var at_front: bool = is_equal_approx(float(lg["depth"]), 1.0) and lg["state"] in ["patrol", "aim", "fire"]
	var big: bool = probe._enemy_scale(lg) > 1.2
	lg["t"] = 99.0
	lg["state"] = "patrol"
	lg["catch"] = Data.BREAKOUT_CATCH_TIME
	probe.bolts = [{"from": Vector2.ZERO, "lane": 0, "t": 0.0, "rank": 1}]
	probe.ducked = true   # v11.21: ducked: it misses
	for i in 20: probe._update_layers(0.05)
	var dodge_ok: bool = probe.dodged >= 1 and probe.hp == 100.0
	probe.ducked = false
	probe.bolts = [{"from": Vector2.ZERO, "lane": 0, "t": 0.0, "rank": 1}]
	# v11.21 (owner): the room is 360: the left stick turns the view; someone behind you is off the screen until you turn
	probe.view_yaw = 0.0
	var behind: bool = probe.screen_x(0.5) < -0.5 or probe.screen_x(0.5) > 1.5
	probe.set_stance(Vector2(1, 0))
	probe._update_layers(1.0)
	var turned: bool = probe.view_yaw > 0.2 and probe.turn > 0.0
	probe.set_stance(Vector2.ZERO)
	for i in 20: probe._update_layers(0.05)
	var hit_ok: bool = probe.hp < 100.0
	for i in 60: probe._update_layers(0.05)
	var caught_ok: bool = probe.hp <= 0.0 and probe.caught_by != ""
	probe.free()
	_check("v11.19 (owner): Orion's fight in 4 layers: soldiers come in at the back, step up layer by layer (bigger), fire real bolts you duck under, all round you in a 360 room you turn with the left stick (v11.21), and one at the front layer for %.1f s catches you" % Data.BREAKOUT_CATCH_TIME,
		start_back and at_front and big and dodge_ok and hit_ok and caught_ok and behind and turned, "back %s front %s big %s dodge %s hit %s caught %s 360 %s turn %s" % [start_back, at_front, big, dodge_ok, hit_ok, caught_ok, behind, turned])
	_check("v11.17 (owner's clips): Orion's lockdown fighters move: guards idle, shoot and fall; the marshal swings his blade", anim_ok)
	_check("v11.15 (owner): Orion's lockdown: every guard is the helmeted Orion soldier, ONE boss (%s, laser blade) and only at the hangar" % str(art["boss_name"]),
		guards_ok and boss_ok and no_mid_boss and hangar_boss, "guards %s boss %s no mid boss %s hangar boss %s" % [guards_ok, boss_ok, no_mid_boss, hangar_boss])

func _job_v92_breakout() -> void:
	_breakout_orion_check()
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var rep0: Dictionary = GS.rep.duplicate()
	var info: Dictionary = s.station.get_meta("info")
	var own: String = Factions.owner_of(info, Data.SYSTEMS[GS.system_id])
	if Factions.has(own): Factions.adjust(own, -(Factions.standing(own) + 70.0))
	main.dock(s.station)
	await _until(func(): return main.state == "hub", 8.0)
	await _frames(3)
	var hb = main.hub
	var bo: Breakout = hb.breakout
	var lock_ok: bool = Factions.hostile(own) and hb.lockdown and bo != null and bo.visible and hb.launch_btn.disabled and not hb.asst.visible
	main.launch()
	await _frames(2)
	lock_ok = lock_ok and main.state == "hub"
	# v9.6 (owner's rules): the first wave walks in (5 guards, each in its own zone); force fields; hits by rank
	var room_ok: bool = bo != null and bo.strip != null and bo.enemies.size() == Data.BREAKOUT_MAX_ON_FLOOR and int(bo.waves()[0]) == 5 \
		and bo.enemies.all(func(e): return float(e["x"]) >= float(e["x0"]) - 0.001 and float(e["x"]) <= float(e["x1"]) + 0.001) \
		and bo.enemies.map(func(e): return int(e["zone"])).size() == Data.BREAKOUT_ZONES.size()
	# v9.3 (owner): the station's own people: the faction's six, cut out, names from the roster
	var cast_ok: bool = bo != null and bo.cast.size() == 6 and bo.cast.values().all(func(c): return c["full"] != null and c["portrait"] != null) \
		and not bo.squad_leader.is_empty() and str(bo.squad_leader["name"]) != ""
	var cast_names: Array = bo.cast.values().map(func(c): return c["name"]) if bo != null else []
	var art_ok := false   # the four factions with lockdown pictures get them; the rest get their normal room, lit red
	if bo != null:
		var probe := Breakout.new()
		probe.faction = "liberator"
		var lt: Texture2D = probe._room_texture("main_hub")
		art_ok = lt != null and lt.resource_path.contains("rooms_hostile") and (bo.strip.resource_path.contains("rooms_hostile") or bo.tint.g < 0.9)
		probe.free()
	await _shot("v92_lockdown", 0.3)
	var duck_ok := false
	var side_ok := false
	var hit_ok := false
	var field_ok := false
	var fire_ok := false
	var rank_ok := false
	var zone_ok := false
	var blade_ok := false
	if bo != null:
		for e in bo.enemies: e["t"] = 99.0   # (everyone keeps patrolling while each move is tried)
		var e0: Dictionary = bo.enemies[0]
		# zones: a guard paces only its own stretch of the floor
		var xs: Array = []
		for i in 40:
			await get_tree().process_frame
			xs.append(float(e0["x"]))
		zone_ok = xs.min() >= float(e0["x0"]) - 0.001 and xs.max() <= float(e0["x1"]) + 0.001 and xs.max() - xs.min() > 0.005
		# 1. ducked: the shot misses
		bo.stick_hold = Vector2(0, 1)
		await _frames(2)
		var hp0 := bo.hp
		var dg0 := bo.dodged
		e0["state"] = "aim"; e0["lane"] = 0; e0["t"] = 0.02
		await _until(func(): return e0["state"] != "aim", 2.0)
		duck_ok = bo.ducked and bo.hp == hp0 and bo.dodged == dg0 + 1
		# 2. side-stepped right while it aimed at the middle: misses
		bo.stick_hold = Vector2(1, 0)
		await _frames(2)
		e0["state"] = "aim"; e0["lane"] = 0; e0["t"] = 0.02
		await _until(func(): return e0["state"] != "aim", 2.0)
		side_ok = bo.lane == 1 and bo.hp == hp0 and bo.dodged == dg0 + 2
		# 3. standing in its line: hit
		bo.stick_hold = Vector2.ZERO
		await _frames(2)
		e0["state"] = "aim"; e0["lane"] = 0; e0["t"] = 0.02
		await _until(func(): return e0["state"] != "aim", 2.0)
		hit_ok = bo.hp < hp0 and bo.hits_taken >= 1
		# 4. the force field: shots on a patrolling guard bounce off
		var e1: Dictionary = bo.enemies[1]
		e1["state"] = "patrol"; e1["t"] = 99.0
		var hp1: int = int(e1["hp"])
		var sb0 := bo.shield_blocks
		bo.aim_at(e1)
		await _wait(0.8)
		field_ok = bo.shielded(e1) and int(e1["hp"]) == hp1 and bo.shield_blocks > sb0
		# 5. its field drops while it fires: now the sight's shots land, one hit each, rank hits to drop it
		e1["state"] = "fire"; e1["t"] = 99.0
		bo.aim_at(e1)
		await _until(func(): return int(e1["hp"]) <= 0, 6.0)
		fire_ok = int(e1["hp"]) <= 0
		rank_ok = bo.enemies.all(func(e): return int(e["max"]) == int(bo.cast.get(int(e["slot"]), {}).get("rank", e["slot"]))) and bo.enemies.any(func(e): return int(e["max"]) == 5)
		await _shot("v96_fields", 0.1)
		# 6. blades: a guard rushes in; read the strike and step away from it (or duck a high one) to counter
		var e2: Dictionary = bo.enemies[2]
		for e in bo.enemies:
			if int(e["hp"]) >= 3: e2 = e   # (a guard who takes more than one hit: the elite)
		bo.start_duel(e2)
		var c0 := bo.counters
		var h2: int = int(e2["hp"])
		bo.duel_side = "left"; bo.duel_t = 0.05; bo.duel_phase = "windup"
		bo.stick_hold = Vector2(1, 0)   # left strike -> step right
		await _until(func(): return bo.counters > c0, 2.0)   # (waits on game time: headless frames are very short)
		var good: bool = bo.counters == c0 + 1 and int(e2["hp"]) == h2 - 1
		await _shot("v96_blades", 0.0)
		var cu0 := bo.cuts
		var hpd := bo.hp
		if not bo.duel.is_empty():
			bo.duel_side = "high"; bo.duel_t = 0.05; bo.duel_phase = "windup"
			bo.stick_hold = Vector2(-1, 0)   # a high strike: side-stepping is wrong (duck it)
			await _until(func(): return bo.cuts > cu0, 2.0)
		var bad: bool = bo.cuts == cu0 + 1 and bo.hp < hpd
		blade_ok = good and bad and Breakout.dodge_for("right") == "left" and Breakout.dodge_for("high") == "duck"
		bo.duel = {}
		bo.stick_hold = null
	# through every room to the hangar: each room's waves, then its boss
	var rooms_seen := 0
	var boss_seen := 0
	var hangar_waves := 0
	for r in Data.BREAKOUT_ROOMS.size():
		if bo == null or not bo.visible: break
		rooms_seen += 1
		if r == Data.BREAKOUT_ROOMS.size() - 1: hangar_waves = bo.waves().size()
		var guard := 0
		while bo.visible and bo.room_i == r and guard < 400:
			guard += 1
			bo.queue.clear()
			for e in bo.enemies: e["hp"] = 0
			if bo.boss_out: boss_seen = maxi(boss_seen, r + 1)
			await _frames(2)
		await _until(func(): return bo.room_i > r or not bo.visible, 5.0)
	await _frames(3)
	var out_ok: bool = rooms_seen == Data.BREAKOUT_ROOMS.size() and not hb.lockdown and not bo.visible and hb.screen == "equipment" and not hb.launch_btn.disabled
	# v9.3 (owner): while their people are hostile, the hub pages show the lockdown pictures where there are some
	var ro0: String = hb.room_override
	hb.room_override = "liberator"   # (a faction with lockdown pictures, standing in for this station's)
	hb.show_screen("hub")
	await _frames(3)
	var swap_ok: bool = hb.room_hostile and hb.room_view.visible and hb.room_key == "liberator_main_hub"
	hb.room_override = ro0
	hb.show_screen("equipment")
	await _frames(2)
	out_ok = out_ok and swap_ok
	_check("v9.2 / v9.6 (owner): docking where they are hostile starts a lockdown (alarm, LAUNCH locked, Evee away); the station's own people (cut out, roster names) walk in, 5 at a time, each pacing its own zone; force fields stop your shots until a guard fires; hits by rank (1-6); duck / side-step dodge their shots; a rush means blades: step away from the strike (duck a high one) to counter; waves, then a boss, room by room through %d rooms to the hangar" % Data.BREAKOUT_ROOMS.size(),
		lock_ok and room_ok and art_ok and cast_ok and zone_ok and duck_ok and side_ok and hit_ok and field_ok and fire_ok and rank_ok and blade_ok and boss_seen == Data.BREAKOUT_ROOMS.size() and hangar_waves == 2 and out_ok,
		"own %s lock %s room %s art %s cast %s %s zone %s duck %s side %s hit %s field %s fire %s rank %s blade %s bosses %d hangar waves %d out %s (rooms %d)" % [own, lock_ok, room_ok, art_ok, cast_ok, cast_names, zone_ok, duck_ok, side_ok, hit_ok, field_ok, fire_ok, rank_ok, blade_ok, boss_seen, hangar_waves, out_ok, rooms_seen])
	GS.rep = rep0
	main.launch()
	await _until(func(): return main.state == "flight", 8.0)
	await _frames(3)

## v9.1 (owner: "1,000 km ... I just hope it doesn't shake"): far out in a 1,000 km system the renderer gets the
## system moved so the ship sits near zero, the camera keeps its exact offset, the ship holds still in view while it
## flies, and the nodes and game logic never see the shift.
var _o_rec: Array = []
func _o_pre() -> void:
	var s := _sp()
	if not is_instance_valid(s.player): return
	var A: Vector3 = s.draw_shift
	var drawn_ship: Vector3 = s.player.global_position - A
	_o_rec.append([drawn_ship, s.drawn_cam.affine_inverse() * drawn_ship, A, s.player.global_position])
func _o_move() -> void:
	var s := _sp()
	if is_instance_valid(s.player): s.player.global_position += Vector3(0.371, 0.113, -0.921) * 2.71828   # (an untidy step, so rounding shows)
func _job_v91_origin() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var keep: Vector3 = s.player.global_position
	s.autopilot = null
	s.player.global_position = SystemBuilder.CENTRE + Vector3(437123.4, 1530.7, -401987.6)
	s._update_camera(1.0, true)
	await _frames(4)
	_o_rec.clear()
	var headless := DisplayServer.get_name() == "headless"   # (CI draws nothing: call the draw step by hand)
	if not headless: RenderingServer.frame_pre_draw.connect(_o_pre)
	for i in 45:
		_o_move()
		await get_tree().process_frame
		await get_tree().process_frame
		if headless:
			s._pre_draw()
			_o_pre()
	if not headless: RenderingServer.frame_pre_draw.disconnect(_o_pre)
	if OS.get_environment("HL_ORIGIN_SHOTS") != "":   # (tools) a picture far out, and one at the station
		get_viewport().get_texture().get_image().save_png(OS.get_environment("HL_ORIGIN_SHOTS") + "/far.png")
	var near_ok := _o_rec.size() > 20
	var logic_ok := true
	var cs: Array = []
	for r in _o_rec.slice(8):
		if (r[0] as Vector3).length() > 16000.0 or (r[2] as Vector3) == Vector3.ZERO: near_ok = false
		if (r[3] as Vector3).x < 400000.0: logic_ok = false   # the node itself stays where the game put it
		cs.append(r[1])
	var mean := Vector3.ZERO
	for v in cs: mean += v
	mean /= maxf(1.0, cs.size())
	var spread := 0.0
	for v in cs: spread = maxf(spread, (v as Vector3).distance_to(mean))
	_check("v9.1 (owner): 1,000 km systems: far out the renderer gets the system moved near zero (the ship within 16 km of it), the ship holds still in the camera's view while flying (spread %.4f m), and the game never sees the shift" % spread,
		Data.SPACE_EDGE == 500000.0 and logic_ok and near_ok and spread < 0.002 and s.shift_frames > 0, "frames %d, last drawn ship %s, shift %s" % [_o_rec.size(), str(_o_rec[-1][0]) if _o_rec.size() else "-", str(_o_rec[-1][2]) if _o_rec.size() else "-"])
	s.player.global_position = keep
	s._update_camera(1.0, true)
	await _frames(3)

## v6.2 (owner): each system is a 1,000 km tile; past 500 km you cross into the next system on the board, and the
## board wraps round Pac-Man style.
func _job_edge() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var home: String = GS.system_id
	var maxc := 0
	var at := {}
	for t in GalaxyData.TILES:
		at[t[0]] = Vector2i(int(t[3]), int(t[4]))
		maxc = maxi(maxc, int(t[3]))
	var far := ""   # a system on the board's east edge
	for id in at:
		if at[id].x == maxc and Data.SYSTEMS.has(id): far = id
	var wrapped: String = main.board_neighbour(far, 1, 0)
	var wrap_ok: bool = wrapped != "" and at[wrapped].x < at[far].x and at[wrapped].y == at[far].y
	var east: String = main.board_neighbour(home, 1, 0)
	var E: float = Data.SPACE_EDGE
	s.autopilot = null
	s.player.global_position = SystemBuilder.CENTRE + Vector3(E + 50.0, 0.0, 300.0)
	var crossed := await _until(func(): return GS.system_id == east and main.state == "flight" and not main.crossing, 25.0)
	var p: Vector3 = main.space.player.global_position - SystemBuilder.CENTRE
	var arrive_ok: bool = crossed and p.x < -E + 3000.0 and p.x > -E - 10.0 and absf(p.z - 300.0) < 3000.0
	_check("v6.2 (owner): a system's space is one tile (v9.1: 1,000 km again); flying past its east edge brings you into the next system east (%s > %s), at its west edge; off the board's edge it wraps round (%s > %s)" % [home, east, far, wrapped],
		E == 500000.0 and wrap_ok and arrive_ok, "crossed %s, arrived at x %.0f km" % [crossed, p.x / 1000.0])
	main._load_system(home, "station")
	await _frames(3)

## v6.2 (owner): the 54 open squares are real space (own sky, no gate); the 17 next to an enemy home are that enemy's
## space: no spaceways, stronger patrols, no docking. The second Kaijurai set flies there, the creatures' tails waving.
func _job_open() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var home: String = GS.system_id
	var open_n := 0
	var held_n := 0
	var sky_ok := true
	for id in Data.SYSTEMS:
		var sy: Dictionary = Data.SYSTEMS[id]
		if not sy.get("open", false): continue
		open_n += 1
		if SystemBuilder.is_enemy_space(sy): held_n += 1
		if not (FileAccess.file_exists("res://assets/skies/%s.jpg" % id) and Packs.PACKS.has("sky_" + id)): sky_ok = false
	_check("v6.2 (owner): all 121 board squares are space you can fly: 67 systems + %d open squares (%d of them enemy-held), each open square with its own sky" % [open_n, held_n],
		open_n == 54 and held_n == 17 and GalaxyData.TILES.size() + open_n == 121 and sky_ok, "open %d, held %d, skies %s" % [open_n, held_n, sky_ok])
	# an enemy-held square (Kaijurai space next to Genesis)
	var held := ""
	for id in Data.SYSTEMS:
		if str(Data.SYSTEMS[id].get("held_by", "")) == "Kaijurai": held = id
	main._load_system(held, "station")
	await _frames(4)
	s = _sp()
	s.player.global_position = s.station.global_position + Vector3(0, 0, 80)
	await _frames(2)
	var strong: bool = not s.enemies.is_empty() and s.enemies.all(func(e): return e.get("enemy_space", false) or e.get("guard", false))
	var e0: Dictionary = s.enemies[0] if not s.enemies.is_empty() else {}
	var tougher: bool = not e0.is_empty() and float(e0["max"]) >= float(Data.ENEMIES[str(e0["def"].get("model", ""))]["hull"] if Data.ENEMIES.has(str(e0["def"].get("model", ""))) else 0.0) * 1.0
	var kaij: bool = s.enemies.any(func(e): return str(e["def"].get("faction", "")) == "Kaijurai")
	var rules: bool = s.lanes.is_empty() and s.dock_candidate() == null and s.gate.global_position.y < -100000.0
	_check("v6.2 (owner): enemy space (%s): no spaceways, no docking at their outpost, no gate, Kaijurai patrols that are stronger (x%.1f)" % [held, Data.ENEMY_SPACE_POWER],
		rules and strong and tougher and kaij, "rules %s, strong %s, kaijurai %s" % [rules, strong, kaij])
	# v6.4 (owner): Kaijurai fighters fly in packs of ten; the kaiju is cruiser-size, tough, fighter-fast, and grabs
	var groups := {}
	for e in s.enemies: groups[e["group"]] = groups.get(e["group"], 0) + 1
	var pack_ok: bool = groups.values().any(func(c): return c >= Data.KAIJU_PACK)
	var big: Array = s.enemies.filter(func(e): return e["def"].get("kaiju", false) or str(e["def"].get("class", "")) == "destroyer")
	var big_ok: bool = not big.is_empty() and float(big[0]["max"]) >= 1600.0 and float(big[0]["def"]["speed"]) >= 40.0 and not big[0]["def"].get("capital", false)
	# the grab: shields, then wings, then the ship
	var kj := s.spawn_unit("kaijurai_stalker", s.player.global_position + Vector3(0, 0, -300), s.player.global_position)
	var god0: bool = GS.god_mode
	GS.god_mode = false   # (the grabs are what is tested)
	GS.restore_full()
	var g1: String = s.kaiju_grab(kj)
	var after1: bool = GS.shield == 0.0 and GS.wing_l > 0.0 and GS.hull > 0.0
	var g2: String = s.kaiju_grab(kj)
	var after2: bool = GS.wing_l == 0.0 and GS.wing_r == 0.0 and GS.hull > 0.0
	GS.restore_full()
	Sections.set_side_visible(s.player_vis, "l", true)
	Sections.set_side_visible(s.player_vis, "r", true)
	# the reach: park inside it and the tentacles stretch out and take the shields
	kj["node"].global_position = s.player.global_position + Vector3(0, 0, -(30.0 + 20.0))
	kj["grab_cd"] = 0.0
	var sh0: float = GS.shield
	await _wait(Data.KAIJU_WINDUP + 0.5)
	var reached: bool = sh0 > 0.0 and GS.shield < sh0 * 0.5 and kj.get("strands", []).size() > 0
	s._destroy_unit(kj)
	GS.god_mode = god0
	GS.restore_full()
	_check("v6.4 (owner): Kaijurai fighters fly in packs of %d; the kaiju (%s) is cruiser-size, hard to kill and fighter-fast; its tentacles reach out and each grab takes your shields, then your wings, then you" % [Data.KAIJU_PACK, str(big[0]["def"]["name"]) if not big.is_empty() else "-"],
		pack_ok and big_ok and g1 == "shields" and after1 and g2 == "wings" and after2 and reached, "pack %s %s, big %s, grabs %s/%s, reach %s" % [pack_ok, str(groups.values()), big_ok, g1, g2, reached])
	# a free open square: a beacon, nothing to dock at, no spaceways
	main._load_system("open_" + "a2" if Data.SYSTEMS.has("open_a2") else Data.SYSTEMS.keys().filter(func(k): return Data.SYSTEMS[k].get("open", false) and not SystemBuilder.is_enemy_space(Data.SYSTEMS[k]))[0], "station")
	await _frames(4)
	s = _sp()
	s.player.global_position = s.station.global_position + Vector3(0, 0, 80)
	await _frames(2)
	_check("v6.2: a free open square has no spaceways and nothing to dock at", s.lanes.is_empty() and s.dock_candidate() == null, s.sys_id)
	# the second Kaijurai set: real models, the right length, nose ahead, the creatures' tails moving
	var models_ok := true
	var detail := ""
	for k in ["kaijurai_fang", "kaijurai_ravager", "kaijurai_stalker", "kaijurai_hound", "kaijurai_reaper"]:
		var m := ShipFactory.build(k)
		var box: AABB = ShipFactory._aabb(m, Transform3D.IDENTITY)
		var longest: float = maxf(box.size.x, maxf(box.size.y, box.size.z))
		var flows: bool = m.find_children("*", "MeshInstance3D", true, false).any(func(mi): return mi.has_meta("flow"))
		var inst: Node3D = m.get_child(0)
		var ok: bool = not m.get_meta("placeholder", true) and absf(longest - float(ShipFactory.GLB[k][1])) < 1.0 and flows and is_equal_approx(inst.rotation_degrees.y, float(ShipFactory.GLB[k][2]))
		if not ok:
			models_ok = false
			detail += "%s(len %.1f, flow %s) " % [k, longest, flows]
		m.free()
	_check("v6.2 (owner): the second Kaijurai set is in: Fang, Ravager, Stalker, Hound, Reaper (real models, their lengths, turned nose-first), their tails flowing", models_ok, detail)
	main._load_system(home, "station")
	await _frames(3)

## v6.5 (owner): the unknown areas (the unmarked squares): strange names, not on the map, no jump gates; a warp gate in a
## cloud and a rift gate in a cloud on the planet; gates move 3 squares; only a few lead back to the charted systems.
func _job_unknown() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var home: String = GS.system_id
	var unk: Array = Data.SYSTEMS.keys().filter(func(k): return SystemBuilder.is_unknown(Data.SYSTEMS[k]))
	var at := {}
	for t in GalaxyData.TILES + SystemBuilder.open_rows(): at[t[0]] = Vector2i(int(t[3]), int(t[4]))
	var bad: Array = []
	var exits := 0
	var named := {}
	for u in unk:
		var sy: Dictionary = Data.SYSTEMS[u]
		named[sy["name"]] = true
		var gs: Array = sy["gates"]
		if gs.is_empty() or gs.any(func(g): return str(g.get("gkind", "")) == "jump"): bad.append(u + " gates")
		for g in gs:
			var d := Vector2i(absi(at[g["to"]].x - at[u].x), absi(at[g["to"]].y - at[u].y))   # (v12.82: no wrap)
			if not (maxi(d.x, d.y) in [3, 4]): bad.append("%s>%s warp %d" % [u, g["to"], maxi(d.x, d.y)])
			if not SystemBuilder.is_unknown(Data.SYSTEMS[g["to"]]): exits += 1
	_check("v6.5 / v12.82 (owner): %d unknown areas, strange names, no jump gates; their warp gates reach 3-4 squares (%d lead out)" % [unk.size(), exits],
		unk.size() >= 10 and named.size() == unk.size() and bad.is_empty() and exits > 0, ", ".join(bad.slice(0, 5)))
	# fly a planet rift: from one planet's surface to another planet's surface (v12.83: a huge whirlpool, in the ground, on
	# the sea bed, on a cliff wall or under a rock roof)
	var u0 := ""
	for sid in Data.SYSTEMS: if u0 == "" and str(Data.SYSTEMS[sid].get("planet_rift", "")) != "" and Surface.PLANETS.has(sid + "_planet") and Surface.PLANETS.has(str(Data.SYSTEMS[sid]["planet_rift"]) + "_planet"): u0 = sid
	var pid: String = u0 + "_planet"
	var to_pid: String = SystemBuilder.planet_rift(pid)
	main._load_surface(pid, 0)
	await _frames(3)
	s = _sp()
	var rg: Node3D = s.planet_rift_gate
	var in_cloud: bool = rg != null and bool(rg.get_meta("rift_pool", false)) and float(rg.get_meta("radius", 0.0)) >= 500.0 and rg.find_child("RiftWhirlpool", true, false) != null
	if rg != null:
		var R0: float = float(rg.get_meta("radius", 600.0))
		var side0: Vector3 = Vector3(rg.global_basis.z.x, 0, rg.global_basis.z.z).normalized() if absf(rg.global_basis.z.y) < 0.9 else Vector3(0, 0, 1)
		s.player.global_position = rg.global_position + side0 * R0 * 2.2 + rg.global_basis.z * R0 * 0.6 + Vector3(0, R0 * 0.9, 0)
		s.player.global_position.y = minf(s.player.global_position.y, Surface.CEILING - 300.0)   # (v12.87: the bigger rift; stay under the sky)
		s._face((rg.global_position - s.player.global_position).normalized())
		s._update_camera(1.0, true)
		await _wait(1.0)
		await _capture("rift_whirlpool_" + s.rift_spot)
		s.player.global_position = rg.global_position + rg.global_basis.z * 160.0
		await _frames(2)
	var docked: bool = main.dock_gate()
	if docked: main.gate_activate()
	var arrived := await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and main.space.surface_mode and main.space.planet_id == to_pid, 40.0)   # (v12.87: the ride is longer)
	s = _sp()
	var near: bool = arrived and s.planet_rift_gate != null and s.player.global_position.distance_to(s.planet_rift_gate.global_position) < float(s.planet_rift_gate.get_meta("radius", 600.0)) * 1.2
	if arrived and s.planet_rift_gate != null:
		var rg2: Node3D = s.planet_rift_gate
		var R2: float = float(rg2.get_meta("radius", 600.0))
		var side2: Vector3 = Vector3(rg2.global_basis.z.x, 0, rg2.global_basis.z.z).normalized() if absf(rg2.global_basis.z.y) < 0.9 else Vector3(0, 0, 1)
		s.player.global_position = rg2.global_position + side2 * R2 * 2.2 + rg2.global_basis.z * R2 * 0.6 + Vector3(0, R2 * 0.9, 0)
		s.player.global_position.y = minf(s.player.global_position.y, Surface.CEILING - 300.0)   # (v12.87: the bigger rift; stay under the sky)
		s._face((rg2.global_position - s.player.global_position).normalized())
		s._update_camera(1.0, true)
		await _wait(1.0)
		await _capture("rift_whirlpool_" + s.rift_spot)
	_check("v12.83 (owner): a planet's rift is a huge whirlpool (%s, %.0f m) on the surface (%s) and takes you to another planet's surface (%s > %s)" % [in_cloud, float(rg.get_meta("radius", 0.0)) if rg != null else 0.0, s.rift_spot, pid, to_pid], in_cloud and docked and arrived and near, "pool %s, docked %s, arrived %s, at its gate %s" % [in_cloud, docked, arrived, near])
	main._load_system(home, "station")
	await _frames(3)

## v6.7 (owner, from Freelancer): the contact list (left) and ship panel (right), both fold away; tap a contact = target;
## guns switch on and off; GO TO goes to the mission first; kills blow up big.
func _job_fl() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var hud = main.hud
	var grp: Array = s._spawn_group(s.player.global_position + Vector3(0, 0, -900), 2)
	await _frames(3)
	hud.slots = {"l": {}, "r": {}}   # (no call covering the panels)
	hud.console_open = false
	hud._layout()
	var list: Array = hud.fl_contacts()
	await _shot("v67_freelancer_panels", 0.4)
	var rows_ok: bool = hud.buttons.has("cl_0") and hud.buttons.has("fl_tab_l") and hud.buttons.has("fl_tab_r") and list.size() >= 2
	var i_e := -1
	for i in list.size():
		if list[i]["node"] == grp[1]["node"]: i_e = i
	main._on_hud("cl_%d" % i_e)
	var picked: bool = s.target == grp[1]["node"]
	main._on_hud("fl_tab_l")
	hud._layout()
	var folded: bool = not hud.cl_open and not hud.buttons.has("cl_0")
	main._on_hud("fl_tab_l")
	# guns: switch every gun off, fire, nothing comes out; back on
	var gr: Array = hud.gun_rows()
	for g in gr: main._on_hud("gun_" + str(g[0]))
	var b0: int = s.bolts.size()
	s._fire_guns()
	var silent: bool = s.bolts.size() == b0 and GS.gun_off.size() == gr.size()
	for g in gr: main._on_hud("gun_" + str(g[0]))
	s.mount_next = {}
	s._fire_guns()
	var fires: bool = s.bolts.size() > b0 and GS.gun_off.is_empty()
	# GO TO: with a job, the job comes first even with a target picked
	var goto_ok := true
	if not s.mission_waypoint().is_empty():
		s.autopilot = null
		s.pick_target(grp[0]["node"])
		main._on_hud("goto")
		var mn: Node3D = s.mission_waypoint()["node"]
		goto_ok = s.autopilot != null and (s.autopilot == mn or s.autopilot.global_position.distance_to(mn.global_position) < 5.0)
		s.autopilot = null
	# a kill: a big blast, bigger for a bigger ship
	s._explode(s.player.global_position + Vector3(0, 0, -200), 7.0)
	var small: float = float(s.last_blast["size"])
	s._explode(s.player.global_position + Vector3(0, 0, -200), 30.0)
	var big_b: float = float(s.last_blast["size"])
	var flash_ok: bool = s.screen_flash > 0.1
	for e in grp:
		if e in s.enemies:
			s.enemies.erase(e)
			(e["node"] as Node3D).free()
	s.target = null
	# v7.0 (owner mockup): cruising, the weapons and abilities fold away; WEAPONS (or a fight) brings them back
	hud.weapons_pinned = false
	hud.weapons_open = false
	var keep_en: Array = s.enemies
	s.enemies = []
	hud._layout()
	await _shot("v70_cruise_hud", 0.3)
	# v7.5 (owner's UI sheet): a full super meter, a missile locked on you, a critical hull: the alert panels show
	var keep_sc: float = GS.super_charge
	var keep_hl: float = GS.hull
	var fake := Node3D.new()
	s.add_child(fake)
	s.enemy_missiles.append({"node": fake, "lost": false, "vel": Vector3.ZERO, "life": 99.0})
	GS.super_charge = 1.0
	GS.hull = GS.max_hull() * 0.15
	await _shot("v75_alerts", 0.3)
	var alerts_ok: bool = hud.space.special_ready() == "meter"
	if not s.enemy_missiles.is_empty() and s.enemy_missiles.back()["node"] == fake: s.enemy_missiles.erase(s.enemy_missiles.back())
	if is_instance_valid(fake): fake.queue_free()
	GS.super_charge = keep_sc
	GS.hull = keep_hl
	_check("v7.5 (owner's UI sheet): a full super meter readies the special; WARNING / DANGER alert panels draw", alerts_ok)
	# v8.3 (owner): TARGET picks the hostile in front of you; CLOAK hides you (no guns, no warp); a barrel roll deflects fire
	var fwd3: Vector3 = -s.player.global_basis.z
	var e_front: Dictionary = s.spawn_unit("raider", s.player.global_position + fwd3 * 500.0, s.player.global_position)
	var e_back: Dictionary = s.spawn_unit("raider", s.player.global_position - fwd3 * 300.0, s.player.global_position)
	for ee in [e_front, e_back]: ee["aggro"] = true
	s.target = e_back["node"]
	main._on_hud("tgt_front")
	var front_ok: bool = s.target == e_front["node"]
	GS.energy = Data.ENERGY_MAX
	main._on_hud("cloak")
	await _frames(3)
	var b0c: int = s.bolts.size()
	s._fire_guns()
	var no_guns: bool = s.bolts.size() == b0c and s.request_warp() == "cloaked"
	var lost: bool = not e_front["aggro"] and not e_back["aggro"]
	var drains: bool = GS.energy < Data.ENERGY_MAX
	main._on_hud("cloak")
	var uncloaked: bool = not s.cloaked
	var keep_h: float = GS.hull
	var keep_s2: float = GS.shield
	s._man_start("left")
	s._player_hit(50.0)
	var deflect_ok: bool = GS.hull == keep_h and GS.shield == keep_s2 and s.deflected > 0
	await _wait(Data.MAN_TIME + 0.2)
	for ee in [e_front, e_back]:
		if ee in s.enemies: s._damage_enemy(ee, 999999.0)
	await _frames(2)
	hud.close_comms()   # (their hail would cover the contact list for the next checks)
	for sd in ["l", "r"]: hud.slots[sd] = {}
	# v8.6 (owner): every gun shows its own bolt (spread muzzles, angled in to meet); a shield hit flashes the force field
	GS.shield = GS.max_shield()
	s.mount_next.clear()
	var nb0: int = s.bolts.size()
	s._fire_guns()
	var fired: Array = s.bolts.slice(nb0)
	var gun_n: int = main.hud.gun_rows().filter(func(g): return not GS.gun_off.has(str(g[0]))).size()
	var spread := 0.0
	for b in fired: spread = maxf(spread, (b["node"] as Node3D).global_position.distance_to((fired[0]["node"] as Node3D).global_position))
	var guns_ok: bool = fired.size() == gun_n and (gun_n < 2 or spread > 1.0)
	s.shield_hit(s.player.global_position + s.player.global_basis.x * 5.0)
	var bubble_ok: bool = s.shield_flash == 1.0 and s._bubble != null and is_instance_valid(s._bubble)
	await get_tree().process_frame
	bubble_ok = bubble_ok and s._bubble.visible and s.shield_flash > 0.0
	await _wait(0.8)
	var bubble_gone: bool = not s._bubble.visible
	_check("v8.6 (owner): every gun fires its own bolt (%d guns, %d bolts, %.1f m apart); a shield hit flashes the force field and it fades" % [gun_n, fired.size(), spread],
		guns_ok and bubble_ok and bubble_gone, "guns %s bubble %s gone %s" % [guns_ok, bubble_ok, bubble_gone])
	_check("v8.3 (owner): TARGET takes the hostile in front of you; CLOAK: hostiles lose you, no guns, no warp, power drains; a barrel roll deflects fire",
		front_ok and no_guns and lost and drains and uncloaked and deflect_ok, "front %s guns/warp %s lost %s drain %s off %s deflect %s" % [front_ok, no_guns, lost, drains, uncloaked, deflect_ok])
	hud.cl_open = false
	hud.sp_open = false
	await _shot("v80_folded", 0.3)
	var fold_ok: bool = hud.fl_rect("l").end.y <= (hud.dash_geo()["blk_l"] as Rect2).position.y and hud.fl_rect("r").end.y <= (hud.dash_geo()["blk_r"] as Rect2).position.y
	hud.cl_open = true
	hud.sp_open = true
	_check("v8.0 (owner): folded, the CONTACTS and SHIP windows sit right on top of their button blocks", fold_ok)
	# v10.6 (owner): round fold tabs on the radar; the tab under it pushes everything down; the cloak crackles, then goes glass and locks every tool
	main._on_hud("dock_l")
	hud._layout()
	var l_gone: bool = not hud.buttons.has("fire") and not hud.buttons.has("tractor") and hud.buttons.has("warp") and not hud.fl_shown("l") and hud.buttons.has("dock_l")
	await _shot("v106_fold_left", 0.3)
	main._on_hud("dock_r")
	hud._layout()
	var both_gone: bool = not hud.buttons.has("warp") and not hud.buttons.has("cloak") and hud.buttons.has("radar") and not hud.fl_shown("r")
	await _shot("v106_radar_only", 0.3)
	main._on_hud("dock_l")
	main._on_hud("dock_r")
	main._on_hud("dock_down")
	hud._layout()
	var down_ok: bool = hud.buttons.has("dock_up") and hud.buttons.has("log") and hud.buttons.has("goto") and hud.buttons.has("tgt_front") and not hud.buttons.has("radar") and not hud.buttons.has("fire")   # (v11.2: GO TO and TARGET stay too)
	await _shot("v106_pushed_down", 0.3)
	main._on_hud("dock_up")
	hud._layout()
	var back_ok: bool = hud.buttons.has("fire") and hud.buttons.has("warp") and hud.buttons.has("radar") and hud.buttons.has("dock_down")
	_check("v10.6 (owner): the radar's side tabs fold the left / right tools away, the tab under it pushes everything down (COMMS and a tab to bring it back stay), and back up",
		l_gone and both_gone and down_ok and back_ok, "left %s both %s down %s back %s" % [l_gone, both_gone, down_ok, back_ok])
	GS.energy = Data.ENERGY_MAX
	main._on_hud("cloak")
	await _wait(0.3)
	await _shot("v106_cloak_zap", 0.0)
	var zapping: bool = s.cloak_zap > 0.0
	await _wait(Data.CLOAK_ZAP + 0.2)
	await _shot("v106_cloak_glass", 0.0)
	var glassy: bool = s._cloak_glass_on
	var ms0: int = GS.slot_ammo("light_missile")
	main._on_hud("kill")
	main._on_hud("warp")
	var locked_ok: bool = s.engine_kill and s.warp_state == "off"   # (v11.25 owner: ENGINE KILL works cloaked; warp stays locked)
	main._on_hud("kill")
	hud.held["thrust"] = true
	await _frames(2)
	var no_thrust: bool = not s.thrust_held
	hud.held.erase("thrust")
	main._on_hud("cloak")
	await _wait(Data.CLOAK_ZAP + 0.2)
	var paint_back: bool = not s._cloak_glass_on and not s.cloaked
	_check("v10.6 (owner): CLOAK crackles with electricity, then the ship goes see-through glass; thrust and warp are locked (v11.25: engine kill works); dropping it brings the paint back",
		zapping and glassy and locked_ok and no_thrust and paint_back and GS.slot_ammo("light_missile") == ms0, "zap %s glass %s locked %s thrust %s back %s" % [zapping, glassy, locked_ok, no_thrust, paint_back])
	# v7.7 (owner): the windows scroll: a drag on the contact list moves it, a tap still picks the row
	var extra: Array = []
	for k in 12:
		var ex: Dictionary = s.spawn_unit("raider", s.player.global_position + Vector3(4000 + k * 300, 0, -6000), s.player.global_position)
		ex["aggro"] = false
		extra.append(ex)
	hud.cl_scroll = 0
	hud._layout()
	var maxs: int = hud.list_max_scroll("l")
	var row0: Rect2 = hud.buttons.get("cl_0", Rect2())
	var tch := InputEventScreenTouch.new()
	tch.index = 7
	tch.position = row0.get_center()
	tch.pressed = true
	hud._input(tch)
	var drg := InputEventScreenDrag.new()
	drg.index = 7
	drg.position = row0.get_center() - Vector2(0, hud.CL_ROW_H * 3.2)
	hud._input(drg)
	var scrolled: int = hud.cl_scroll
	tch.pressed = false
	tch.position = drg.position
	hud._input(tch)
	var tg_keep = s.target
	hud._layout()
	var pick_id := "cl_%d" % hud.cl_scroll
	var prow: Rect2 = hud.buttons.get(pick_id, Rect2())
	tch.pressed = true
	tch.position = prow.get_center()
	hud._input(tch)
	tch.pressed = false
	hud._input(tch)
	await _frames(2)
	var want: Node3D = hud.fl_contacts()[hud.cl_scroll]["node"]
	var tapped_ok: bool = s.target == want
	for ex in extra:
		if ex in s.enemies: s._damage_enemy(ex, 999999.0)
	hud.cl_scroll = 0
	_check("v7.7 (owner): a long contact list scrolls with a drag (%d of %d rows hidden) and a tap still picks the row" % [maxs, hud.fl_contacts().size()],
		maxs > 0 and scrolled == mini(3, maxs) and tapped_ok and prow.size.x > 0.0, "max %d scrolled %d tapped %s" % [maxs, scrolled, tapped_ok])
	hud._layout()
	var hidden: bool = hud.buttons.has("ground") and hud.buttons.has("tractor") and hud.buttons.has("fire")   # (v8.0: all on the console now) and hud.buttons.has("thrust") and hud.buttons.has("weapons")   # (v7.6: the console always shows; only TRACTOR / GROUND pop up)
	main._on_hud("weapons")
	hud._layout()
	var shown: bool = hud.buttons.has("tractor") and hud.buttons.has("ground") and hud.buttons.has("special")
	main._on_hud("weapons")
	s.enemies = keep_en
	var rr: Rect2 = hud.radar_rect()
	var fr: Rect2 = hud.fl_rect("r")
	var placed: bool = hud.buttons.has("goto") and (hud.buttons["goto"] as Rect2).end.x <= rr.position.x and hud.fl_rect("l").encloses(hud.buttons["tgt_front"]) and hud.buttons.has("cloak") and hud.buttons.has("radar") and hud.buttons.has("target") \
		and ["weapons", "log"].all(func(b): return hud.buttons.has(b) and fr.encloses(hud.buttons[b])) \
		and not hud.buttons.has("fullscreen") and (hud.buttons["view"] as Rect2).is_equal_approx(hud.dash_geo()["view"]) \
		and ["fire", "kill", "thrust", "shield", "form", "tractor", "special"].all(func(b): return hud.buttons.has(b) and (hud.buttons[b] as Rect2).end.x <= rr.position.x) \
		and ["stop", "warp", "repair", "cloak", "view", "ground"].all(func(b): return hud.buttons.has(b) and (hud.buttons[b] as Rect2).position.x >= rr.end.x)   # (v7.6: the console: left wing, radar, right wing; SPEED = the view button)
	hud.weapons_pinned = true
	_check("v7.0 (owner mockup): cruising, the weapons and abilities fold away (the flight row stays); WEAPONS brings them back; GO TO beside NEXT in the left window (v7.4; the radar is the map); WEAPONS / COMMS in the right window; v7.6 console: shield, hull and four buttons left of the radar, power, super and four right; SPEED is the view button",
		hidden and shown and placed, "hidden %s shown %s placed %s" % [hidden, shown, placed])
	_check("v6.7 (owner, Freelancer): a contact list (left) and ship panel (right) that fold away; tap a contact = target; guns switch on and off; GO TO goes to the job first; kills blow up big (%.0f, a big ship %.0f) with a flash" % [small, big_b],
		rows_ok and picked and folded and silent and fires and goto_ok and small >= 50.0 and big_b > small * 2.0 and flash_ok,
		"rows %s, picked %s, folded %s, guns off %s on %s, goto %s, flash %s" % [rows_ok, picked, folded, silent, fires, goto_ok, flash_ok])

func _job_v35() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	main.dock(s.station)
	await _until(func(): return main.state == "hub", 8.0)
	var hb = main.hub
	hb.room_override = "liberator"
	hb.show_screen("ships")
	await Packs.wait("room_liberator_shipyard", 30.0)
	await _frames(3)
	var rv: ColorRect = hb.room_view
