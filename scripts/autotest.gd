	var ctxt := "no crew here (%s, seams %d)" % [key, sm.size()]
	if not cr.who.is_empty() and not sm.is_empty():
		await _frames(3)
		var on_seam: bool = sm.any(func(x): return absf(fposmod(float(x) - float(cr.who.get("_home_yaw", -1.0)) + 0.5, 1.0) - 0.5) < 0.002)
		var want: float = 0.0
		if not big.is_empty(): want = (float(big["feet"]) - float(big["top"])) * Data.ROOM_ZOOM * get_viewport().get_visible_rect().size.y
		var sized: bool = big.is_empty() or absf(cr.body_px - want) < want * 0.25
		crew_ok = on_seam and sized
		ctxt = "on seam %s body %.0f px (biggest %.0f)" % [on_seam, cr.body_px, want]
	_check("Rooms: the walking crew stand on a seam, sized to the biggest people in the room", crew_ok, ctxt)
	hb.room_override = ""

func _finish_group() -> void:
	var passed := results.filter(func(r): return r["pass"]).size()
	print("[route] RESULT %d/%d PASS" % [passed, results.size()])
	get_tree().quit(0 if passed == results.size() else 1)

## v11.57 (owner's Dreadholm update): tests/systems/dreadholm - stations, hidden rival, planet set + fallback, boarding,
## Repair Reputation. Run: HL_DREADHOLM=1 (tests/systems/dreadholm/run.sh).
func _dreadholm() -> void:
	if main.state == "hub": main.launch()
	await _until(func(): return main.state == "flight", 10.0)
	main._load_system("dreadholm", "station")
	await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and main.space.sys_id == "dreadholm", 15.0)
	await _wait(1.0)
	var s := _sp()
	await _until(func(): return not s.extras.is_empty() or not s.hidden_extras.is_empty(), 6.0)   # (the extra stations are built PH_BUILD_DELAY after arrival)
	await _frames(2)
	var sy: Dictionary = Data.SYSTEMS["dreadholm"]
	# 1. three stations: the hub, the ally, the hidden rival
	var names: Array = [str(sy["station"]["name"])]
	for b in sy["more_stations"]: names.append("%s (%s, %s)" % [b["name"], b["role"], b["faction"]])
	var rival: Dictionary = {}
	var ally: Dictionary = {}
	for b in sy["more_stations"]:
		if b["role"] == "rival": rival = b
		if b["role"] == "ally": ally = b
	var three: bool = sy["more_stations"].size() == 2 and not ally.is_empty() and not rival.is_empty() and str(ally["faction"]) == "Covenant" and str(rival["faction"]) == "Unity" and bool(rival["hidden"])
	GS.found_stations.erase(str(rival.get("id", "")))
	main.navmap.open(s)
	await _frames(2)
	var on_map_before := false
	for k in main.navmap.objs:
		if str(main.navmap.objs[k]["name"]) == str(rival.get("name", "")): on_map_before = true
	main.navmap.visible = false
	main._on_map_closed()
	var rnode: Node3D = null
	for n: Node3D in s.hidden_extras: if str((n.get_meta("info", {}) as Dictionary).get("id", "")) == str(rival.get("id", "")): rnode = n
	var neb: Dictionary = sy.get("nebula", {})
	var in_veil: bool = rnode != null and not neb.is_empty() and rnode.global_position.distance_to(neb["center"]) < float(neb["radius"]) * Data.NEBULA_SIZE
	var hidden_ok: bool = rnode != null and not (rnode in s.extras) and not on_map_before and in_veil
	if rnode != null: _tp(rnode.global_position + Vector3(0, 0, Data.HIDDEN_FIND_RANGE * 0.6), rnode.global_position)
	await _until(func(): return rnode != null and rnode in s.extras, 3.0)
	main.navmap.open(s)
	await _frames(2)
	var on_map_after := false
	for k in main.navmap.objs:
		if str(main.navmap.objs[k]["name"]) == str(rival.get("name", "")): on_map_after = true
	main.navmap.visible = false
	main._on_map_closed()
	var found_ok: bool = rnode != null and rnode in s.extras and rnode in s.docks3d and on_map_after and str(rival["id"]) in GS.found_stations
	_check("Dreadholm: 3 stations (Fleet Command hub, Covenant ally, Unity rival); the rival is hidden in the Veil, off the map until found, then charted and dockable",
		three and hidden_ok and found_ok, "%s · three %s hidden %s in veil %s found %s" % [", ".join(names), three, hidden_ok, in_veil, found_ok])
	# 2. the planet's own set loads, with fallback to the Fleet Command hub; the lava card on the map
	main.dock(s.planet)
	var on_planet := await _until(func(): return main.state == "hub", 10.0)
	var hb = main.hub
	var pf: String = hb.room_file("orion_main_hub") if on_planet else ""
	var want_own := ResourceLoader.exists("res://assets/rooms/orion/planet_dreadholm_main_hub.jpg")
	var fallback_ok: bool = on_planet and hb.kind == "planet" and (pf == "planet_dreadholm_main_hub" if want_own else pf == "main_hub")
	var card_ok: bool = NavGrid.planet_picture(sy["planet"]) == "res://assets/planet_cards/dreadholm.jpg" and str(sy["planet"]["palette"]) == "lava" and str(Data.SYSTEMS["vortegan"]["planet"]["palette"]) == "desert"
	_check("Dreadholm planet: its own 10-room set loads (or falls back to the Fleet Command hub room when a picture is missing); the map card is the lava art; Orion biomes set",
		fallback_ok and card_ok, "on planet %s room %s (own art %s) card %s" % [on_planet, pf, want_own, card_ok])
	var dv := _develop_check()
	_check("Every system is developed: %d systems with gates off the edge, 2+ worlds, lanes to every gate, none through the star or rocks" % int(dv["n"]),
		int(dv["n"]) >= 50 and (dv["bad"] as Array).is_empty(), "%d systems, problems %d: %s" % [dv["n"], (dv["bad"] as Array).size(), str((dv["bad"] as Array).slice(0, 12))])
	# 3. Repair Reputation at the ally station: charges credits, raises standing (never past green)
	if main.state == "hub": main.launch()
	await _until(func(): return main.state == "flight", 10.0)
	s = _sp()
	var an: Node3D = null
	for n: Node3D in s.extras: if str((n.get_meta("info", {}) as Dictionary).get("role", "")) == "ally": an = n
	var rep_ok := false
	var rep_txt := "no ally node"
	if an != null:
		main.dock(an)
		await _until(func(): return main.state == "hub", 10.0)
		hb = main.hub
		Factions.adjust("Covenant", -40.0 - Factions.standing("Covenant"))
		GS.credits = 50000
		var c0 := GS.credits
		var st0 := Factions.standing("Covenant")
		var listed: bool = "Covenant" in hb.rep_repair_factions()
		var cost: int = hb.rep_repair_cost("Covenant")
		hb.repair_rep("Covenant")
		var paid: bool = GS.credits == c0 - cost and cost > int(Data.REP_REPAIR_BASE)
		var rose: bool = Factions.standing("Covenant") > st0
		for i in 12: hb.repair_rep("Covenant")
		var capped: bool = Factions.standing("Covenant") <= Data.REP_REPAIR_UNTIL + 0.01
		rep_ok = hb.base.get("role", "") == "ally" and listed and paid and rose and capped
		rep_txt = "ally %s listed %s cost %d paid %s rose %.0f -> %.0f capped %s" % [hb.base.get("role", ""), listed, cost, paid, st0, Factions.standing("Covenant"), capped]
		main.launch()
		await _until(func(): return main.state == "flight", 10.0)
	_check("Dreadholm ally station: REPAIR REPUTATION charges credits (dearer the lower you are) and raises your standing, up to green", rep_ok, rep_txt)
	# 4. battleships: shield-gated access, no dock option, infiltration in mech mode, 3 rooms, generator, hangar escape
	var no_dock := true
	for e in _sp().fleet_patrols:
		if (e["node"] as Node3D).get_meta("dock", false) or (e["node"] in _sp().docks3d): no_dock = false
	_check("Battleships (allied ones too) have no dock option", no_dock)
	await _dreadholm_layout()
	await _job_v1145()

## v11.63 (owner's freighter block): both freighter types spawn on the lanes, a booster hit slows the ship (it is not
## destroyed until the hull is gone), and the head is the same size on both types. Run: HL_CARGO=1.
func _cargo() -> void:
	if main.state == "hub": main.launch()
	await _until(func(): return main.state == "flight", 10.0)
	var s := _sp()
	if s.lanes.is_empty():
		main._load_system("solara", "station")
		await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and not main.space.lanes.is_empty(), 15.0)
		s = _sp()
	await _wait(0.5)
	var types := {}
	var on_lane := true
	for f in s.freighters:
		types[int(f["type"])] = true
		var p: Vector3 = (f["node"] as Node3D).global_position
		var near := INF
		for ln in s.lanes:
			for q in ln["up"] + ln["down"]: near = minf(near, p.distance_to(q))
		if near > Data.LANE_RING_GAP: on_lane = false
	_check("Cargo: both freighter types fly the trade lanes", types.has(1) and types.has(2) and on_lane, "types %s on lane %s (%d lanes)" % [types.keys(), on_lane, s.lanes.size()])
	var f1: Dictionary = {}
	for f in s.freighters:
		if int(f["type"]) == 1: f1 = f
	var ok := false
	var txt := "no type 1"
	if not f1.is_empty():
		var n: Node3D = f1["node"]
		var bp: Vector3 = s.freighter_zone_point(f1, "booster")
		var side: Vector3 = n.global_basis.x
		var zone: String = s.freighter_seg_zone(f1, bp + side * 40.0, bp - side * 40.0)
		var v0: float = s.freighter_speed(f1)
		s.hit_freighter(f1, float(f1["boost_max"]) + 1.0, zone)
		var v1: float = s.freighter_speed(f1)
		var p0 := n.global_position
		await _wait(1.0)
		var moved := n.global_position.distance_to(p0) if is_instance_valid(n) else -1.0
		ok = zone == "booster" and absf(v1 - v0 * Data.FREIGHTER_CRAWL) < 0.01 and not f1["dead"] and float(f1["hp"]) > 0.0 and moved < v0 * 0.3
		txt = "zone %s speed %.1f -> %.1f, moved %.1f m in 1 s, hull %d, alive %s" % [zone, v0, v1, moved, int(f1["hp"]), not f1["dead"]]
	_check("Cargo: a broken booster leaves the freighter crawling (~10% speed), not destroyed", ok, txt)
	var heads: Array = []
	var bodies: Array = []
	for t in [1, 2]:
		var m := ShipFactory.build(Data.CARGO_SHIPS["Orion"]["t%d" % t])
		add_child(m)
		var box: AABB = ShipFactory._aabb(m, Transform3D.IDENTITY)
		var L := box.size.z
		var z: Dictionary = Data.FREIGHTER_ZONES[t - 1]
		heads.append(L * float(z["head"]))
		bodies.append(L * (1.0 - float(z["head"]) - float(z["booster"])))
		m.queue_free()
	var same: bool = absf(heads[0] - heads[1]) < 0.6 and absf(heads[0] - Data.FREIGHTER_HEAD_LEN) < 1.0 and bodies[1] > bodies[0] * 1.5 and bodies[0] > heads[0]
	_check("Cargo: the head is the Cadet's size on both types; type 2's body is much bigger", same, "head %.1f / %.1f m, body %.1f / %.1f m" % [heads[0], heads[1], bodies[0], bodies[1]])

## v11.64 (owner: "engine kill at warp doesn't neutralize the warp"): KILL at warp (also on GO TO) keeps the warp speed,
## lets go of the autopilot, you can turn and every weapon fires; THRUST in that drift keeps the speed (swung to the nose).
func _warp_kill() -> void:
	var s := _sp()
	GS.energy = Data.ENERGY_MAX
	if is_instance_valid(s.station):   # v11.91: GO TO goes round a station in the way, not through it
		var c: Vector3 = s.station.global_position
		var R: float = s._station_reach()
		s.player.global_position = c + Vector3(0, 0, R + 800.0)
		var ap0 = s.autopilot
		s.autopilot = null
		var d: Vector3 = s._detour(c + Vector3(0, 0, -(R + 6000.0)))
		s.autopilot = ap0
		var seg_ok := true
		for i in 21:
			var q: Vector3 = (c + Vector3(0, 0, R + 800.0)).lerp(d, i / 20.0)
			if q.distance_to(c) < R: seg_ok = false
		_check("GO TO: the run from in front of a station to a point behind it goes round the station, not through it", seg_ok and d.distance_to(c) > R, "detour %s (reach %.0f m) clear %s" % [d - c, R, seg_ok])
	if is_instance_valid(s.station):   # (v11.91: start clear of the 4x station, out to the side)
		s.player.global_position = s.station.global_position + Vector3(s._station_reach() + 2500.0, 0, 0)
		s.vel = Vector3.ZERO
	s.autopilot = s.gates[0] if not s.gates.is_empty() else s.planet
	s.player.look_at(s.autopilot.global_position)
	s.yaw = s.player.rotation.y
	s.pitch = s.player.rotation.x
	s.request_warp()
	var on := await _until(func(): return s.warp_state == "on", 12.0)
	await _wait(0.5)
	var v_warp: float = s.speed_now
	main._on_hud("kill")
	# v11.64 (owner: "COMMS should only switch the right screen"): the console comes up on the right; the left window stays
	var hud = main.hud
	var l_before: bool = hud.fl_shown("l")
	hud.open_log()
	await _wait(1.0)
	var cr: Rect2 = hud.contacts_rect()
	var right_side: bool = cr.position.x > hud.S.x * 0.5 and cr.end.x <= hud.S.x + 1.0
	var l_after: bool = hud.fl_shown("l")
	var r_gone: bool = not hud.fl_shown("r")
	_check("Flight: COMMS opens on the right screen only; the left window stays as it was", right_side and l_after == l_before and r_gone,
		"panel %s, left window %s -> %s, right window hidden %s" % [cr, l_before, l_after, r_gone])
	hud.close_roster()
	await _wait(0.3)
	var drift: bool = s.engine_kill and s.warp_drift and s.autopilot == null and s.warp_state == "off"
	var y0: float = s.yaw
	main.hud.aim_vec = Vector2(1, 0)
	await _wait(1.0)
	main.hud.aim_vec = Vector2.ZERO
	var turned: float = absf(angle_difference(y0, s.yaw))
	var kept: bool = s.speed_now > v_warp * 0.9 and s.warp_state == "off"
	GS.energy = Data.ENERGY_MAX
	s.gun_cd = 0.0
	var nb: int = s.bolts.size()
	s.fire_lock = true
	var shot: bool = await _until(func(): return s.bolts.size() > nb or s.shots_fired > 0 if "shots_fired" in s else s.bolts.size() > nb, 1.5)
	s.fire_lock = false
	var mis: bool = s.trigger_system("missile")
	main.hud.held["thrust"] = true
	await _wait(1.0)
	main.hud.held.erase("thrust")
	var boost_kept: bool = s.engine_kill and s.speed_now > v_warp * 0.9 and s.vel.normalized().dot(-s.player.global_basis.z) > 0.8
	_check("Flight: KILL at warp (on GO TO too) keeps the warp speed, drops the autopilot, turns, fires guns and missiles; THRUST keeps the speed, swung to the nose",
		on and drift and turned > 0.3 and kept and shot and mis and boost_kept,
		"warp %s %.0f m/s; drift %s; turned %.2f rad; kept %s; guns %s missile %s; thrust kept %s (%.0f m/s)" % [on, v_warp, drift, turned, kept, shot, mis, boost_kept, s.speed_now])
	main._on_hud("kill")

## v11.65 (owner's Dreadholm map talk-through): the star by the lava world, Covenant at D.5 8.5, Vassal at B.5 6.5, the
## gates further out, every planned lane built (with the T choke points and the outer ring), and no lane through the
## new rock field, the storm cloud, the asteroid belt or the star.
func _dreadholm_layout() -> void:
	var s := _sp()
	var sy: Dictionary = s.sys
	var W: float = 2.0 * Data.SPACE_EDGE / Data.MAP_CELLS
	var at := func(p: Vector3, c: Array) -> bool: return Vector2(p.x, p.z).distance_to(Vector2(SystemBuilder.cell_pos(c).x, SystemBuilder.cell_pos(c).z)) < W * 0.05
	var cov := false
	var vas := false
	for x in sy["more_stations"]: if str(x["name"]) == "Covenant Embassy": cov = at.call(x["pos"], [4.5, 8.5])
	for x in sy["more_planets"]: if str(x["name"]) == "Vassal": vas = at.call(x["pos"], [2.5, 6.5])
	# v11.99 (owner: "yes, the lane rules in Dreadholm"): the freeway grid now: the star sits well off every lane
	var sun_ok := true
	var spos: Vector3 = SystemBuilder.sun_pos_of(sy)
	for sg in SystemBuilder.layout_segments(sy):
		var qq: Vector3 = Geometry3D.get_closest_point_to_segment(spos, sg[0], sg[1])
		if Vector2(qq.x - spos.x, qq.z - spos.z).length() < Data.SUN_RADIUS * 3.0: sun_ok = false
	cov = (sy["more_stations"] as Array).any(func(x): return str(x["name"]) == "Covenant Embassy")
	vas = (sy["more_planets"] as Array).any(func(x): return str(x["name"]) == "Vassal")
	var far := true
	var edge_bad: Array = []
	var pl: float = Data.SPACE_EDGE * 0.8
	for sid in Data.SYSTEMS:
		var S2: Dictionary = Data.SYSTEMS[sid]
		var pts2: Array = [["station", S2["station"]["pos"]], ["planet", S2["planet"]["pos"]]]
		for g in S2.get("gates", []): pts2.append([str(g["name"]), g["pos"]])
		for x in S2.get("more_planets", []) + S2.get("more_stations", []): pts2.append([str(x["name"]), x["pos"]])
		for q in pts2:
			if absf((q[1] as Vector3).x) >= pl or absf((q[1] as Vector3).z) >= pl: edge_bad.append("%s: %s" % [sid, q[0]])
	_check("Map edge: no station, planet or jump gate in the border squares of any system (only asteroids and clouds)", edge_bad.is_empty(), "%d out: %s" % [edge_bad.size(), edge_bad.slice(0, 8)])
	far = far and edge_bad.is_empty()
	_check("Dreadholm map (freeway grid): the star well off every lane, Covenant and Vassal there, nothing in the border squares",
		sun_ok and cov and vas and far, "sun %s covenant %s vassal %s gates out %s" % [sun_ok, cov, vas, far])
	var plan: int = sy["lane_plan"].size()
	var meet := {}
	for ln in s.lanes:
		for k in ["a", "b"]: meet[str(ln[k])] = int(meet.get(str(ln[k]), 0)) + 1
	var tees := true   # v11.99: every junction is where lanes meet (a T, a crossing or a turn)
	for jn in sy["junctions"]: if int(meet.get(str(jn), 0)) < 2: tees = false
	var cov_lane: bool = s.lanes.any(func(l): return str(l["b"]) == "Covenant Embassy" or str(l["a"]) == "Covenant Embassy")
	var avoid: Array = [[SystemBuilder.sun_pos_of(sy), Data.SUN_RADIUS * 1.2, "star"], [s.belt_center, s.belt_radius, "belt"]]
	for c in sy["layout_clouds"]:
		if str(c.get("weather", "")) == "rocks": avoid.append([c["center"], float(c["radius"]), str(c["name"])])
	for nd in s.nebulae:   # every cloud with rocks in it: the rocks gather within 0.6 of its radius
		if not nd.get("layout", false) and (str(nd.get("weather", "")) == "rocks" or nd["main"]): avoid.append([nd["center"], float(nd["radius"]) * 0.65, "rocks in %s" % (str(nd["name"]) if str(nd["name"]) != "" else "a cloud")])
	var stn: Array = []   # (and never through a station on the way)
	for x in sy["more_stations"]: stn.append([x["pos"], 3000.0, str(x["name"])])
	# (v11.69 owner: lanes may cross clouds, just not asteroids)
	var through := []
	for ln in s.lanes:
		var pts: Array = ln["up"]
		for i in pts.size() - 1:
			for av in avoid:
				var q: Vector3 = Geometry3D.get_closest_point_to_segment(av[0], pts[i], pts[i + 1])
				if Vector2(q.x - av[0].x, q.z - av[0].z).length() < float(av[1]) and not (str(av[2]) in through): through.append("%s (%s-%s)" % [av[2], ln["a"], ln["b"]])
			for st in stn:
				if str(st[2]) == str(ln["a"]) or str(st[2]) == str(ln["b"]): continue
				var q2: Vector3 = Geometry3D.get_closest_point_to_segment(st[0], pts[i], pts[i + 1])
				if q2.distance_to(st[0]) < float(st[1]) and not (str(st[2]) in through): through.append("%s (%s-%s)" % [st[2], ln["a"], ln["b"]])
	_check("Dreadholm lanes (freeway grid): all %d planned lanes built, every junction joins lanes, a lane reaches Covenant, no lane runs through the asteroids (belt, rock field) or the star" % plan,
		s.lanes.size() == plan and tees and cov_lane and through.is_empty(), "built %d / %d, tees %s %s, covenant lane %s, through %s" % [s.lanes.size(), plan, tees, meet, cov_lane, through])

## v11.66 (owner): a MISSION battleship can be boarded once its shield is down (the shield takes a while to come back),
## or once its hull is at half (then the shield never comes back); explosions throw real sparks, embers, smoke and
## debris; the nuke is a spiked ball that grows, holds, grows again and turns slowly.
func _board_fx() -> void:
	var s := _sp()
	var p: Node3D = s.player
	var at: Vector3 = p.global_position - p.global_basis.z * 2500.0
	var e: Dictionary = s._spawn_capital("inv_battleship", "battleship", at, at + Vector3(0, 0, 400), "Unity")
	await _frames(3)
	var boardable: bool = e.get("boardable", false)
	e["sh"] = 1.0
	s._damage_enemy(e, 5.0)
	await _frames(3)
	var slow: bool = is_equal_approx(float(e["sh_cd"]) + 0.1, Data.BOARD_SHIELD_DELAY + 0.1) or float(e["sh_cd"]) > 10.0
	var open1: bool = s.board_open(e)
	_tp(e["node"].global_position + Vector3(0, 0, float(e["def"].get("hit_r", 200.0)) + 200.0), e["node"].global_position)
	await _frames(3)
	var cand: bool = s.board_candidate() == e
	_check("Boarding: a MISSION battleship can be boarded once its shield is down (BOARD shows close by); its shield waits %d s before it starts back" % int(Data.BOARD_SHIELD_DELAY),
		boardable and open1 and cand and slow, "boardable %s open %s BOARD %s shield wait %.1f s" % [boardable, open1, cand, float(e["sh_cd"])])
	var e2: Dictionary = s._spawn_capital("inv_battleship", "battleship", at + Vector3(3000, 0, 0), at, "Orion")
	await _frames(3)
	e2["sh"] = e2["sh_max"]
	e2["hp"] = float(e2["max"]) * 0.49
	await _frames(3)
	var half_open: bool = e2.get("shield_broken", false) and float(e2["sh"]) <= 0.0
	e2["sh_cd"] = 0.0
	await _wait(1.0)
	var stays: bool = float(e2["sh"]) <= 0.0 and s.board_open(e2)
	_check("Boarding: hull at half opens the hangar even with the shield up, and that shield never comes back", half_open and stays, "open %s stays down %s (sh %.0f)" % [half_open, stays, float(e2["sh"])])
	for o in [e, e2]:
		if o in s.enemies:
			s.enemies.erase(o)
			(o["node"] as Node3D).free()
	var b0: int = s.fx_bursts
	var bat: Vector3 = p.global_position - p.global_basis.z * 300.0
	s._explode(bat, 30.0)
	await _frames(2)
	var parts := 0
	for c in s.get_children():
		if c.name.begins_with("BurstFX"): parts += c.get_children().filter(func(x): return x is CPUParticles3D).size()
	s._spawn_group(p.global_position - p.global_basis.z * 200.0, 1)
	var fe: Dictionary = s.enemies[s.enemies.size() - 1]
	var bk0: int = s.breakups
	s._destroy_unit(fe)
	await _frames(2)
	var burning: int = s._pieces.size()
	var moving := false
	if burning > 0:
		var pp: Vector3 = (s._pieces[0]["node"] as Node3D).global_position
		await _wait(0.3)
		moving = s._pieces.size() > 0 and (s._pieces[0]["node"] as Node3D).global_position.distance_to(pp) > 1.0
	_check("Explosions (Freelancer): a fighter breaks into burning pieces that tumble away trailing fire and smoke", s.breakups == bk0 + 1 and burning >= 3 and moving, "breakups %d -> %d, pieces %d, flying %s" % [bk0, s.breakups, burning, moving])
	_check("Explosions: a ship blowing up throws sparks, embers, smoke and debris (particles)", s.fx_bursts > b0 and parts >= 4, "bursts %d -> %d, particle systems %d" % [b0, s.fx_bursts, parts])
	s.missile_blast(bat, {"heavy": true, "nuke": true}, null)
	await _frames(2)
	var fx: Node3D = null
	for c in s.get_children():
		if c.name.begins_with("NukeFX"): fx = c
	var lg: Array = s.nuke_fx_log[-1] if not s.nuke_fx_log.is_empty() else [0, 0.0, 0.0]
	var live: Dictionary = s.nuke_fx_live[-1] if not s.nuke_fx_live.is_empty() else {}
	var tiles_ok: bool = fx != null and (s._nuke_tile_mesh().get_faces().size() / 3) == Data.NUKE_TILES * Data.NUKE_TILES * 6 * 4
	var inside_ok: bool = not live.is_empty() and (live["smoke"] as Array).size() == Data.NUKE_SMOKE and (live["seeds"] as Array).size() == Data.NUKE_ARCS
	var rot0: float = fx.rotation.y if fx != null else 0.0
	await _wait(float(Data.NUKE_FX_TIMES[0]) + float(Data.NUKE_FX_TIMES[1]) * 0.5)
	var s1: float = fx.scale.x if is_instance_valid(fx) else 0.0
	var arcs_ok: bool = is_instance_valid(fx) and ((live["arcs"] as MeshInstance3D).mesh as ImmediateMesh).get_surface_count() == 1
	await _wait(float(Data.NUKE_FX_TIMES[1]) * 0.5 + float(Data.NUKE_FX_TIMES[2]) * 0.85)
	var s2: float = fx.scale.x if is_instance_valid(fx) else 0.0
	var turned: float = absf((fx.rotation.y if is_instance_valid(fx) else rot0) - rot0)
	var faded: float = float((live["mats"][0] as ShaderMaterial).get_shader_parameter("fade")) if is_instance_valid(fx) else 0.0
	await _wait(float(Data.NUKE_FX_TIMES[2]) * 0.3)
	var gone := not is_instance_valid(fx)
	_check("Nuke: a lumpy ball of square tiles rising to small pyramid points, purple smoke and %d arcs of electricity inside; it keeps growing while it turns slowly (half a turn), then it all fades together" % Data.NUKE_ARCS,
		tiles_ok and inside_ok and arcs_ok and s2 > s1 * 1.2 and turned > Data.NUKE_TURN * 0.7 and faded < 0.3 and gone,
		"tiles %s inside %s arcs %s size %.0f then %.0f, turned %.2f rad, fade %.2f, gone %s" % [tiles_ok, inside_ok, arcs_ok, s1, s2, turned, faded, gone])
	# the full run, from a MISSION battleship
	var mb: Dictionary = s._spawn_capital("inv_battleship", "battleship", s.player.global_position - s.player.global_basis.z * 2500.0, s.player.global_position, "Unity")
	await _frames(3)
	GS.form = "mech"
	main.board_battleship(mb)
	await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and main.space.boarding, 15.0)
	var inside: bool = is_instance_valid(main.space) and main.space.boarding
	var wk: Dictionary = await _board_walkthrough() if inside else {"ok": false, "txt": "never got in"}
	_check("Boarding run (owner): a mech through corridors and sliding doors, guards in each room, the core, the way back seals, 90 s to the OTHER exit, out: the battleship blows, %d ships wait, clear them and Command pays" % Data.BOARD_WAVE, inside and bool(wk["ok"]), str(wk["txt"]))

