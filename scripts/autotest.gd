## v11.94 (owner: "every system should have all the development basics"): every system with a layout (made or by hand)
## has gates off the edge squares, at least 2 worlds, lanes to every gate, and no lane through the star or a rock field.
func _develop_check() -> Dictionary:
	var bad: Array = []
	var n := 0
	var w: float = 2.0 * Data.SPACE_EDGE / float(Data.MAP_CELLS)
	for sid in Data.SYSTEMS:
		var sy: Dictionary = Data.SYSTEMS[sid]
		if not sy.has("lane_plan") or (sy["lane_plan"] as Array).is_empty(): continue
		n += 1
		var sun: Vector3 = SystemBuilder.sun_pos_of(sy)
		var rocks: Array = (sy.get("layout_clouds", []) as Array).filter(func(c): return str(c.get("weather", "")) == "rocks")
		var gates_in := {}
		for ln in sy["lane_plan"]:
			for k in ln: if str(k).begins_with("gate:"): gates_in[str(k)] = true
			var a: Vector3 = SystemBuilder.layout_point(sy, str(ln[0]))
			var b: Vector3 = SystemBuilder.layout_point(sy, str(ln[1]))
			if a == Vector3.INF or b == Vector3.INF:
				bad.append("%s: %s" % [sid, ln])
				continue
			var ab := b - a
			var t := clampf((sun - a).dot(ab) / maxf(ab.length_squared(), 1.0), 0.0, 1.0)
			if (a + ab * t).distance_to(sun) < Data.SUN_RADIUS * 1.2: bad.append("%s: %s through the star" % [sid, ln])
			for rc in rocks:
				var c: Vector3 = rc["center"]
				var t2 := clampf((c - a).dot(ab) / maxf(ab.length_squared(), 1.0), 0.0, 1.0)
				if (a + ab * t2).distance_to(c) < float(rc["radius"]): bad.append("%s: %s through %s" % [sid, ln, rc["name"]])
		for g in sy["gates"]:
			var cc: Vector2 = SystemBuilder.cell_of(g["pos"])
			if cc.x < 2.0 or cc.y < 2.0 or cc.x > float(Data.MAP_CELLS) or cc.y > float(Data.MAP_CELLS): bad.append("%s: gate %s on an edge square" % [sid, g["to"]])
			if not gates_in.has("gate:" + str(g["to"])): bad.append("%s: no lane to gate %s" % [sid, g["to"]])
		if (sy.get("more_planets", []) as Array).is_empty(): bad.append("%s: one world only" % sid)
		# v11.98 (owner: Rimgate, "you can't have parallel trade lanes"): no two lanes that don't meet run within 20 km of
		# each other, and two lanes leaving one place are at least 18 degrees apart. The hand-made systems are the owner's.
		if Data.SYSTEM_LAYOUT.has(sid): continue
		var segs: Array = SystemBuilder.layout_segments(sy).map(func(sg): return [SystemBuilder.cell_of(sg[0]), SystemBuilder.cell_of(sg[1])])
		for i in segs.size():
			for j in range(i + 1, segs.size()):
				var A: Array = segs[i]
				var B: Array = segs[j]
				var shared := Vector2.INF
				for pa: Vector2 in A: for pb: Vector2 in B: if pa.distance_to(pb) < 0.01: shared = pa
				if shared == Vector2.INF:
					if SystemBuilder._seg_seg_d(A[0], A[1], B[0], B[1]) < 0.2: bad.append("%s: lanes side by side" % sid)
				else:
					var oa: Vector2 = A[1] if (A[0] as Vector2).distance_to(shared) < 0.01 else A[0]
					var ob: Vector2 = B[1] if (B[0] as Vector2).distance_to(shared) < 0.01 else B[0]
					if (oa - shared).normalized().dot((ob - shared).normalized()) > cos(deg_to_rad(18.0)): bad.append("%s: two lanes leave one place together" % sid)
		if str(sy.get("faction", "")) == "Neutral" and not (sy.get("more_stations", []) as Array).any(func(x): return str(x.get("role", "")) == "ally"): bad.append("%s: neutral space with no freeport" % sid)
	return {"n": n, "bad": bad}

## v11.96 (owner: Armored Core facilities): every difficulty builds a facility whose halls and tunnels join up along the
## way in and the way out, never overlap, get deeper and bigger with the level, and come out at the most-east exit.
func _facility_check() -> Dictionary:
	var res: Array = []
	var ok := true
	var prev_rooms := 0
	for d in [1, 2, 3, 4]:
		var L: Dictionary = Boarding.facility("test_world:site%d" % d, d, "Test %d" % d)
		Boarding.use(L)
		var joined := true
		for route in [L["route_in"], L["route_out"]]:
			for i in (route as Array).size() - 1:
				if Boarding.joint(str(route[i]), str(route[i + 1])).is_empty():
					joined = false
					res.append("gap %s-%s" % [route[i], route[i + 1]])
		var overlap := false
		var ks: Array = (L["rooms"] as Dictionary).keys()
		for i in ks.size():
			for j in range(i + 1, ks.size()):
				var A: Array = L["rooms"][ks[i]]["r"]
				var B: Array = L["rooms"][ks[j]]["r"]
				if float(A[0]) < float(B[1]) - 1.0 and float(B[0]) < float(A[1]) - 1.0 and float(A[2]) < float(B[3]) - 1.0 and float(B[2]) < float(A[3]) - 1.0:
					overlap = true
					res.append("overlap %s %s" % [ks[i], ks[j]])
		var east := true
		for k in ks: if float(L["rooms"][k]["r"][1]) > float(L["rooms"]["sbay"]["r"][1]) + 0.5: east = false
		var shapes := {}
		var xs := {}
		for k in ks:
			shapes[str(L["rooms"][k].get("shape", "tunnel"))] = true
			if L["rooms"][k].has("xsec"): xs[str(L["rooms"][k]["xsec"])] = true
		var n: int = ks.size()
		if not joined or overlap or not east or n <= prev_rooms: ok = false
		prev_rooms = n
		res.append("L%d: %d areas, %d levels, joined %s overlap %s exit-east %s shapes %s tunnels %s" % [d, n, int(L["info"]["levels"]), joined, overlap, east, shapes.keys(), xs.keys()])
	Boarding.use_ship()
	return {"ok": ok, "txt": " | ".join(res)}

## v11.70 (owner): the boarding run, start to end, inside the battleship (call once the mech is inside): the doors slide
## open as you walk up (the way out is locked), each room's guards come when you walk in, the core's shield drops once
## the hall is clear, the core blows: the way you came seals, the far door opens, 90 s; out through the aft launch bay,
## the battleship goes up, 20 fighters wait outside, clear them and you are paid. Returns {ok, txt}.
func _board_walkthrough() -> Dictionary:
	var s := _sp()
	var res: Array = []
	var y := func(x: float, z: float) -> float: return Boarding.floor_at(Vector3(x, 0, z)) + 6.0
	var layout_ok: bool = Boarding.ROOMS.size() >= 14 and s.board_doors.size() >= Boarding.ROOMS.size() - 1
	var esc: Dictionary = {}
	var seal: Dictionary = {}
	for d in s.board_doors:
		if Boarding.is_door(d, Boarding.ESCAPE_DOOR): esc = d
		if Boarding.is_door(d, Boarding.SEAL_DOOR): seal = d
	# the way in and the way out are both joined door to door; the way out is short enough to run in the time
	var joined := true
	for route in [Boarding.ROUTE_IN, Boarding.ROUTE_OUT]:
		for k in range(1, route.size()):
			if Boarding.joint(route[k - 1], route[k]).is_empty(): joined = false
	var run := 0.0
	var prev := Boarding.CORE_AT
	for k in Boarding.ROUTE_OUT.slice(1):
		var r: Array = Boarding.ROOMS[k]["r"]
		var c := Vector3((float(r[0]) + float(r[1])) * 0.5, 0, (float(r[2]) + float(r[3])) * 0.5)
		run += Vector2(c.x - prev.x, c.z - prev.z).length()
		prev = c
	run += Boarding.EXIT_X - prev.x
	var walk: float = float(GS.ship()["speed"]) * Data.GROUND_WALK
	var in_time: bool = run / walk < Data.BOARD_ESCAPE * 0.85
	layout_ok = layout_ok and not esc.is_empty() and bool(esc["locked"]) and not seal.is_empty() and joined and in_time
	res.append("%d areas, %d doors, joined %s, way out locked %s, run out %.0f m = %.0f s walking" % [Boarding.ROOMS.size(), s.board_doors.size(), joined, bool(esc.get("locked", false)), run, run / walk])
	var first: Dictionary = {}
	for d in s.board_doors:
		if Boarding.is_door(d, ["lbay", "t1"]): first = d
	_tp(Vector3(-350, y.call(-350, 0), 0), Vector3(0, 0, 0))
	await _wait(1.4)
	var opens: bool = not first.is_empty() and float(first["open"]) > 0.95
	var e0: int = s.enemies.size()
	_tp(Vector3(-60, y.call(-60, 0), 0), Vector3(-60, 0, 200))
	await _frames(4)
	var guards: bool = (s.board["woke"] as Dictionary).has("muster") and s.enemies.size() >= e0 + int(Boarding.ROOMS["muster"]["guards"])
	var on_deck: bool = absf(s.player.global_position.y - y.call(-60, 0)) < 3.0
	res.append("door slides open %s, muster hall mechs %s, on the sunken deck %s" % [opens, guards, on_deck])
	# the bridge: its mech, then the hostage
	_tp(Vector3(-60, y.call(-60, -400), -400), Vector3(-60, 40, -480))
	await _frames(4)
	var bm: Dictionary = s.board.get("bridge", {})
	if not bm.is_empty() and s.enemies.has(bm): s._destroy_unit(bm)
	await _frames(4)
	var hp: Node3D = s.board.get("hostage")
	if is_instance_valid(hp): _tp(Vector3(hp.global_position.x, y.call(hp.global_position.x, hp.global_position.z), hp.global_position.z), hp.global_position + Vector3(0, 0, 10))
	await _frames(4)
	var hostage: bool = not bm.is_empty() and bool(s.board["hostage_pay"])
	res.append("bridge mech -> hostage freed %s" % hostage)
	# the reactor: the shut way out holds, their boss, the shield, the blast
	_tp(Vector3(114, y.call(114, 800), 800), Vector3(114, -100, 700))
	await _frames(3)
	s.player.global_position = Vector3(114, y.call(114, 800), 781.0)   # (walking into the shut door from the reactor side)
	await _frames(3)
	var blocked: bool = s.player.global_position.z > 780.5
	var boss: Dictionary = s.board.get("boss", {})
	var shielded: bool = not boss.is_empty() and bool(s.board["core"].get("locked", false)) and (s.board["shield"] as Node3D).visible
	for k in s.board["guards"].get("reactor", []) + ([boss] if not boss.is_empty() else []):
		if s.enemies.has(k): s._destroy_unit(k)
	await _frames(4)
	var core: Dictionary = s.board["core"]
	var unlocked: bool = not bool(core.get("locked", true)) and not (s.board["shield"] as Node3D).visible
	s._damage_enemy(core, 999999.0)
	await _frames(4)
	var escape: bool = str(s.board["phase"]) == "escape" and absf(float(s.board["escape"]) - Data.BOARD_ESCAPE) < 1.0 and bool(seal["sealed"]) and not bool(esc["locked"]) and s._board_path.visible
	res.append("shut door blocks %s, boss + shielded reactor %s, boss down -> shield down %s, reactor down -> sealed / way out open / %d s %s" % [blocked, shielded, unlocked, int(Data.BOARD_ESCAPE), escape])
	var cr0 := GS.credits
	_tp(Vector3(400, y.call(400, 120), 120), Vector3(500, 6, 120))
	await _frames(3)
	s.player.global_position = Vector3(Boarding.EXIT_X + 2.0, 6, 120)
	await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and not main.space.boarding and not main.space.post_wave.is_empty(), 12.0)
	var s2 := _sp()
	var wave: int = (s2.post_wave.get("kids", []) as Array).size()
	var waited: bool = wave == Data.BOARD_WAVE and GS.credits == cr0 + (Data.BOARD_BOUNTY_PAY if hostage else 0)
	for k in (s2.post_wave.get("kids", []) as Array).duplicate():
		if s2.enemies.has(k): s2._destroy_unit(k)
	await _frames(4)
	var paid: bool = s2.post_wave.is_empty() and GS.credits >= cr0 + Data.BOARD_PAY
	res.append("out the starboard side: %d ships waiting, battleship not paid yet %s; all down -> paid %s" % [wave, waited, paid])
	if GS.form == "mech": s2.start_transform()
	return {"ok": layout_ok and opens and guards and on_deck and hostage and blocked and shielded and unlocked and escape and waited and paid, "txt": " · ".join(res)}
func _smoke_core() -> void:
	_check("Core: the game boots to its title / main menu", main.state == "title", main.state)
	main.start_game()
	var flying := await _until(func(): return main.state == "flight", 20.0)
	_check("Core: a new game starts in flight", flying, main.state)
	await _frames(3)
	var fsb: Control = Fs.btn
	_check("Core: in flight FULL SCREEN sits in the top bar", fsb.get_global_rect().position.y < 50.0 and fsb.get_global_rect().is_equal_approx(main.hud.fs_slot), str(fsb.get_global_rect()))

func _launch() -> bool:
	main.launch()
	return await _until(func(): return main.state == "flight", 8.0)

## HL_SHOWCASE=1: short scripted fight for reviewing combat visuals (laser bolts, missile flame, enemy bars, pilot call).
func _showcase() -> void:
	await _wait(1.0)
	main.start_game()
	await _until(func(): return main.state == "flight", 10.0)
	await _wait(1.0)
	var s := _sp()
	var p: Node3D = s.player
	s.player.global_position += -p.global_basis.z * 250.0
	await _wait(0.3)
	s._spawn_group(p.global_position - p.global_basis.z * 220.0, 1)
	var e: Dictionary = s.enemies[s.enemies.size() - 1]
	s.target = e["node"]
	for i in 5:
		s._fire_guns()
		await _wait(0.1)
	await _capture("showcase_lasers")
	s.set_view("cockpit")
	for i in 5:
		s._fire_guns()
		await _wait(0.1)
	await _capture("showcase_lasers_cockpit")
	s.set_view("chase")
	s.fire_missile()
	await _wait(0.3)
	await _capture("showcase_missile")
	await _wait(0.6)
	main._pilot_call(Data.PILOTS["raider"][0], true)
	await _wait(0.5)
	await _capture("showcase_call")
	get_tree().quit()

## An env flag, or on the web the same name in the page address (?autotest&HL_V19Z) to run one job in the browser.
var _shots_done := {}
func _flag(n: String) -> bool:
	if OS.get_environment(n) != "": return true
	if OS.has_feature("web"): return str(JavaScriptBridge.eval("location.search", true)).find(n) >= 0
	return false

func _run() -> void:
	seed(1234)   # Nov 2 (owner): a fixed seed for the whole route test
	main.hud.cl_open = true   # (v8.0: the windows start folded; the checks read them open)
	main.hud.sp_open = true
	main.hud.weapons_pinned = true   # (v7.0: every button up for the checks; the pop-up has its own check)
	if not _flag("HL_PLANETSITES"): SpaceSystem.patrols_on = false   # v12.54: the planet patrols only where they're tested
	if not _flag("HL_LOADOUT"): SpaceSystem.loadout_on = false   # v12.67: the older checks fly the old gun mounts
	if not _flag("HL_LANDFILM"):   # v12.52: the landing film is cut short in the other checks (they time the descent)
		main.landing_film_min = 0.0
		main.landing_film_max = 0.4
	if _flag("HL_FLEETBOARD"):   # v13.89 (owner: "use the same gameplay from the regular board missions"): a traced fleet deck in the boarding engine
		var fid := "imperium_trooptransport"
		main.start_game()
		await _until(func(): return main.state == "flight", 10.0)
		await _wait(1.0)
		for kind in ["sabotage", "capture", "rescue"]:
			main.board_fleet_ship(fid, kind, {})
			await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and main.space.boarding and main.hud.visible, 90.0)
			await _wait(1.5)
			var s := _sp()
			var b: Dictionary = s.board
			var hb = main.hud
			var soldiers := 0
			var cards := 0
			for e in s.enemies:
				if bool(e.get("soldier", false)): soldiers += 1
				if e.has("card"): cards += 1
			var hud_ok: bool = hb.visible and hb.buttons.has("fire") and hb.buttons.has("cutter")
			_check("%s %s: the regular boarding HUD, on foot, %d GLB soldiers, %d card carriers, %d doors (%d card doors)" % [fid, kind, soldiers, cards, s.board_doors.size(), s.board_doors.filter(func(d): return int(d.get("key", 0)) > 0).size()],
				hud_ok and s.pilot_rig != null and soldiers >= 10 and cards == 2 and b.has("fleet") and s.board_doors.filter(func(d): return int(d.get("key", 0)) > 0).size() == 9, "hud %s (vis %s fire %s target %s) rig %s" % [hud_ok, hb.visible, hb.buttons.has("fire"), hb.buttons.has("target") or hb.buttons.has("tgt_front"), s.pilot_rig != null])
			_check("%s %s: you start in the deploy bay" % [fid, kind], Boarding.room_at(s.player.global_position) == "sbay", Boarding.room_at(s.player.global_position))
			if kind == "sabotage":
				await _capture("fb_start")
				main.hud.planet_map = true
				await _wait(0.4)
				await _capture("fb_map")
				main.hud.planet_map = false
				# you can't leave yet
				s.player.global_position = Vector3(Boarding.EXIT_X + 3.0, s.player.global_position.y, s.player.global_position.z)
				await _wait(0.4)
				_check("%s: no leaving before the job is done" % fid, s.player.global_position.x < Boarding.EXIT_X and str(b["phase"]) != "out", str(s.player.global_position.x))
				# a card door stays shut, then opens with its card
				var kd: Dictionary = s.board_doors.filter(func(d): return int(d.get("key", 0)) == 1)[0]
				var c0: Vector3 = kd["center"]
				s.player.global_position = Vector3(c0.x, s.player.global_position.y, c0.z - 40.0)
				await _wait(1.2)
				var shut_ok: bool = float(kd["open"]) < 0.2
				await _capture("fb_yellow_door")
				s._fleet_card(1, c0)
				await _wait(1.2)
				_check("%s: the YELLOW door stays shut without the card, opens with it" % fid, shut_ok and float(kd["open"]) > 0.8, "%s %s" % [shut_ok, kd["open"]])
				# the card carriers really carry them
				var carrier: Dictionary = s.enemies.filter(func(e): return e.has("card"))[0]
				s._destroy_unit(carrier)
				await _wait(0.3)
				_check("%s: beating a card guard gives his card" % fid, s._fleet_has(1))
			var tgt: Vector3 = b["fleet"]["target_at"]
			s._fleet_card(2, tgt)
			s.player.global_position = Vector3(tgt.x + 30.0, Boarding.floor_at(tgt) + 6.0, tgt.z + 30.0)
			await _wait(1.0)
			await _capture("fb_target_" + kind)
			if kind == "sabotage": s._destroy_unit(b["core"])
			elif kind == "capture": s._destroy_unit(b["fleet"]["captain"])
			await _wait(0.6)
			_check("%s %s: the job's target is done" % [fid, kind], bool(b["fleet"]["done"]), str(b["fleet"]["done"]))
			var ex: Array = Boarding.ROOMS["sbay"]["r"]
			s.player.global_position = Vector3(float(ex[1]) - 10.0, s.player.global_position.y, (float(ex[2]) + float(ex[3])) * 0.5)
			s.vel = Vector3(200, 0, 0)
			await _wait(0.6)
			if is_instance_valid(s) and s.boarding: s.player.global_position.x = Boarding.EXIT_X + 5.0
			await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and not main.space.boarding, 20.0)
			await _wait(1.0)
			_check("%s %s: out through the deploy bay, back in space" % [fid, kind], main.state == "flight" and not main.space.boarding, main.state)
		_finish_group()
		return
	if _flag("HL_FLEETDECK"):   # v13.78 fleet interiors programme: every ship rebuilt from an approved traced plan
		main.autotest_old_deck = true   # (v13.89: the old walk-through stage, not the boarding run)
		var ids := ["imperium_trooptransport"]
		if OS.get_environment("HL_FLEETDECK") not in ["", "1"]: ids = OS.get_environment("HL_FLEETDECK").split(",")
		for sid in ids:
			var ok0: bool = main.open_ship_interior(sid)
			await _wait(0.8)
			var sd: ShipInterior = main.ship_deck
			_check("%s: the traced deck loads" % sid, ok0 and is_instance_valid(sd) and bool(sd.data.get("approved_plan", false)))
			_check("%s: few enough pieces for phones (< 900 drawn)" % sid, sd.pieces_drawn() < 900, str(sd.pieces_drawn()))
			await _wait(0.3)
			var entry_room := str(sd.room_now)
			_check("%s: you board in the entry room" % sid, entry_room.begins_with("Deploy Bay") or entry_room.contains("Hangar") or entry_room.contains("Airlock"), entry_room)
			await _shot("fd_%s_entry" % sid, 0.3)
			var bad := []
			for r in sd.data["rooms"]:
				sd.body.global_position = sd.room_point(str(r["name"])) + Vector3(0, 0.1, 0)
				await _wait(0.25)
				if sd.room_now != str(r["name"]): bad.append("%s->%s" % [r["name"], sd.room_now])
				if str(r["name"]) in ["Troop Bay", "Bridge", "Command & Control", "Reactor Core", "Vehicle / Dropship Bay", "Barracks A"]:
					await _shot("fd_%s_%s" % [sid, str(r["name"]).to_lower().replace(" ", "_").replace("/", "").left(14)], 0.2)
			_check("%s: every room is a room you can stand in" % sid, bad.is_empty(), str(bad))
			# a locked door stays shut without its card and opens with it
			var lk: Array = sd.gates.filter(func(g): return int(g["level"]) > 0)
			if not lk.is_empty():
				var g0: Dictionary = lk[0]
				sd.keys = [true, false, false, false]   # (the room tour may have walked past a key guard)
				var side: Vector3 = (g0["slide"] as Vector3).cross(Vector3.UP).normalized() * 1.6
				sd.body.global_position = (g0["pos"] as Vector3) + side + Vector3(0, 0.1, 0)
				await _wait(0.6)
				_check("%s: a %s door stays shut without its card" % [sid, ShipInterior.KEY_NAME[int(g0["level"])]], not bool(g0["open"]))
				await _shot("fd_%s_locked" % sid, 0.2)
				for kk in range(1, int(g0["level"]) + 1): sd.give_key(kk)
				await _wait(0.8)
				_check("%s: and opens with it" % sid, bool(g0["open"]))
				await _shot("fd_%s_unlocked" % sid, 0.2)
			for kind in ["sabotage", "capture", "rescue"]:
				if not (sd.data.get("objectives", {}) as Dictionary).has(kind): continue
				sd.start_mission(kind)
				sd.body.global_position = sd.objective_pos(kind) + Vector3(0.5, 0.1, 0)
				await _wait(0.4)
				var got: bool = sd.m_stage == 1
				sd.body.global_position = sd.hangar_pos() + Vector3(0, 0.1, 0)
				await _wait(0.4)
				_check("%s: %s: reach the target, back to the entry, done" % [sid, kind], got and sd.m_stage == 2, str(sd.m_stage))
			sd.close()
			await _wait(0.5)
			_check("%s: LEAVE SHIP puts you back" % sid, not is_instance_valid(main.ship_deck))
		_finish_group()
		return
	if _flag("HL_DECKWEB"):   # v13.78: why the boarded deck draws black on the web: one shot per renderer setting
		main.open_ship_interior("imperium_trooptransport")
		await _wait(1.0)
		var sd: ShipInterior = main.ship_deck
		await _shot("dw_0_as_is", 0.5)
		var env0: WorldEnvironment = sd.world.find_children("*", "WorldEnvironment", true, false)[0]
		env0.environment.background_color = Color(0.8, 0.1, 0.8)
		print("[deckweb] vp size ", sd.vp.size, " cam current ", sd.cam.current, " cam ", sd.cam.global_transform, " body ", sd.body.global_position, " shell ", sd.shell)
		var img := sd.vp.get_texture().get_image()
		print("[deckweb] vp mean ", img.get_pixel(img.get_width() / 2, img.get_height() / 2), " ", img.get_pixel(10, 10))
		await _shot("dw_0b_magenta_bg", 0.5)
		var probe := MeshInstance3D.new()
		var pbm := BoxMesh.new(); pbm.size = Vector3.ONE
		probe.mesh = pbm
		var pmat := StandardMaterial3D.new(); pmat.albedo_color = Color(1, 0.2, 0.1); pmat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		probe.material_override = pmat
		sd.world.add_child(probe)
		probe.global_position = sd.cam.global_position - sd.cam.global_transform.basis.z * 3.0
		await _shot("dw_0c_probe_box", 0.5)
		var geo: Array = sd.world.find_children("*", "GeometryInstance3D", true, false)
		var summ := {}
		for g in geo:
			var k: String = g.get_class() + ":" + str(g.name).rstrip("0123456789_").left(14)
			summ[k] = int(summ.get(k, 0)) + 1
		print("[deckweb] geometry ", geo.size(), " drawn ", sd.pieces_drawn(), " merged ", sd.merged_pieces, " ", summ)
		for g in geo: if g != probe: (g as GeometryInstance3D).visible = false
		await _shot("dw_0d_probe_alone", 0.5)
		var groups := {"walls": ["ShellWalls", "Chamfers", "Cover", "WallTrim", "LightStrip", "Ceiling"], "floor": ["Floor"]}
		for gname in groups:
			for g in geo:
				for pre in groups[gname]: if str(g.name).begins_with(pre): (g as GeometryInstance3D).visible = true
			await _shot("dw_0e_plus_" + gname, 0.5)
		for g in geo: (g as GeometryInstance3D).visible = g is MeshInstance3D and not (g as MeshInstance3D).mesh is ArrayMesh
		await _shot("dw_0f_primitive_meshes", 0.5)
		for g in geo: (g as GeometryInstance3D).visible = true
		sd.vp.msaa_3d = Viewport.MSAA_DISABLED
		await _shot("dw_1_no_msaa", 0.5)
		var env: WorldEnvironment = sd.world.find_children("*", "WorldEnvironment", true, false)[0]
		env.environment.fog_enabled = false
		await _shot("dw_2_no_fog", 0.5)
		env.environment.tonemap_mode = Environment.TONE_MAPPER_LINEAR
		await _shot("dw_3_linear", 0.5)
		for m in sd.world.find_children("*", "GeometryInstance3D", true, false): (m as GeometryInstance3D).visible = false
		await _wait(0.1)
		for m in sd.world.find_children("*", "GeometryInstance3D", true, false): (m as GeometryInstance3D).visible = true
		await _shot("dw_4_reshown", 0.5)
		for m in sd.world.find_children("*", "Label3D", true, false): (m as Node3D).visible = false
		await _shot("dw_5_no_labels", 0.5)
		for m in sd.world.find_children("*", "MeshInstance3D", true, false):
			var mi := m as MeshInstance3D
			if mi.mesh is ArrayMesh: mi.visible = false
		await _shot("dw_6_no_arraymesh", 0.5)
		_check("deck web probe done", true)
		_finish_group()
		return
	if _flag("HL_LANDFILM"):   # v12.52 (owner): the landing film while the ground loads, Evee's briefing, a fresh world on a return
		main.start_game()
		await _until(func(): return main.state == "flight", 10.0)
		await _wait(1.0)
		await Packs.wait("planets", 60.0)
		var s := _sp()
		var pid0: String = s.planet.get_meta("info")["id"]
		var pc: Vector3 = s.planet.global_position
		var pr: float = s.planet.get_meta("radius")
		var dd := (s.player.global_position - pc).normalized()
		_tp(pc + dd * (pr + 90.0), pc)
		main.hud.move_vec = Vector2(0, -1)
		await _until(func(): return main.state == "atmosphere", 8.0)
		main.hud.move_vec = Vector2.ZERO
		await _until(func(): return is_instance_valid(main.space) and main.space.surface_mode and main.space.cine_t > 2.0, 90.0)
		await _capture("landing_film")
		await _until(func(): return main.state == "flight" and main.space.surface_mode, 40.0)
		await _wait(1.0)
		s = _sp()
		var first_ok: bool = main.landing_film_s >= Data.LANDING_FILM_MIN - 0.1 and s.cine_t < 0.0 and int(GS.planet_visits.get(pid0, 0)) == 1 and main.on_call == "assistant"
		var built: bool = s.ground_ready() or main.landing_film_s >= Data.LANDING_FILM_MAX - 0.1
		await _capture("landing_out")
		_check("v12.52 (owner): coming down, a film of your ship in the clouds while the ground loads (%.1f s), then the chase view; Evee briefs you (first visit)" % main.landing_film_s, first_ok and built, "film %.1f cine %.1f visits %s call %s ready %s" % [main.landing_film_s, s.cine_t, GS.planet_visits, main.on_call, s.ground_ready()])
		# up and back down: a second visit, a fresh world
		GS.block_deltas[pid0 + "|0|0|0"] = [[0, 0, 0, "gun"]]
		main.leave_atmosphere()
		await _until(func(): return main.state == "flight" and not main.space.surface_mode, 40.0)
		await _wait(1.0)
		s = _sp()
		pc = s.planet.global_position
		dd = (s.player.global_position - pc).normalized()
		_tp(pc + dd * (pr + 90.0), pc)
		main.hud.move_vec = Vector2(0, -1)
		await _until(func(): return main.state == "atmosphere", 8.0)
		main.hud.move_vec = Vector2.ZERO
		await _until(func(): return main.state == "flight" and main.space.surface_mode, 90.0)
		await _wait(1.0)
		var again: bool = int(GS.planet_visits.get(pid0, 0)) == 2 and int(BlockField.visit_salt.get(pid0, 0)) == 1 and not GS.block_deltas.has(pid0 + "|0|0|0") and main.on_call == "assistant"
		await _capture("landing_again")
		_check("v12.52 (owner): back on a world you've been to: nothing kept from last time, a new seed, and Evee knows it (visit %d)" % int(GS.planet_visits.get(pid0, 0)), again, "visits %s salt %s deltas kept %s" % [GS.planet_visits, BlockField.visit_salt, GS.block_deltas.has(pid0 + "|0|0|0")])
		_finish_group()
		return
	if OS.get_environment("HL_ESCAPE") == "" and not _flag("HL_BREAKOUT") and not _flag("HL_CUTTER"): main.hub.escape_3d = false   # v12.30: the older lockdown checks test the panorama fight (HL_ESCAPE tests the 3D one)
	if OS.get_environment("HL_SMOKE") != "":   # Nov 2 (owner): the fast pre-deploy check (< 2 min)
		await _smoke()
		_finish_group()
		return
	if OS.get_environment("HL_ROOMS") != "":   # v11.59: the rooms UI checks (+ the core group)
		await _smoke_core()
		await _rooms_ui()
		_finish_group()
		return
	if OS.get_environment("HL_LAYDUMP") != "":   # v11.98: every system's layout in map squares, for the map pictures (tools/maps/render_maps.py)
		var lay := {}
		var C := func(p: Vector3) -> Array: var c := SystemBuilder.cell_of(p); return [snappedf(c.x, 0.01), snappedf(c.y, 0.01)]
		for id in Data.SYSTEMS:
			var sd: Dictionary = Data.SYSTEMS[id]
			if not sd.has("station") or not sd.has("planet"): continue
			var w: float = 2.0 * Data.SPACE_EDGE / float(Data.MAP_CELLS)
			var o := {"name": sd.get("name", id), "faction": str(sd.get("faction", "")), "tile": str(sd.get("tile", "")), "hub": [sd["station"]["name"], C.call(sd["station"]["pos"])],
				"planets": [[sd["planet"]["name"], C.call(sd["planet"]["pos"]), float(sd["planet"].get("radius", 800.0)) / w]], "stations": [], "gates": [], "junctions": [], "lanes": [], "clouds": [],
				"sun": [C.call(SystemBuilder.sun_pos_of(sd)), Data.SUN_RADIUS * Data.SUN_KEEP_OUT / w]}
			for x in sd.get("more_planets", []): o["planets"].append([x["name"], C.call(x["pos"]), float(x.get("radius", 500.0)) / w])
			for x in sd.get("more_stations", []): o["stations"].append([x["name"], C.call(x["pos"]), str(x.get("faction", "")), bool(x.get("hidden", false))])
			for g in sd.get("gates", []): o["gates"].append([str(g["name"]), C.call(g["pos"]), str(g.get("gkind", "jump"))])
			for jn in sd.get("junctions", {}): o["junctions"].append([jn, C.call(sd["junctions"][jn])])
			if sd.has("lane_plan"):
				for sg in SystemBuilder.layout_segments(sd): o["lanes"].append([C.call(sg[0]), C.call(sg[1])])
			for nb in SpaceSystem.nebulae_of(id, sd): o["clouds"].append([C.call(nb["center"]), float(nb["radius"]) / w, (nb["color"] as Color).to_html(false), str(nb.get("weather", ""))])
			if sd.has("asteroids") and float(sd["asteroids"].get("radius", 0.0)) > 1.0: o["belt"] = [C.call(sd["asteroids"]["center"]), float(sd["asteroids"]["radius"]) / w]
			lay[id] = o
		var lf := FileAccess.open(OS.get_environment("HL_LAYDUMP"), FileAccess.WRITE)
		lf.store_string(JSON.stringify(lay))
		lf.close()
		print("[laydump] ", lay.size())
		get_tree().quit()
		return
