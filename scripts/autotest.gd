func _job_v111() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var hud = main.hud
	hud.dock_l = true
	hud.dock_r = true
	hud.dock_down = false
	hud._layout()
	await _frames(2)
	var b: Dictionary = hud.buttons
	var tl: Rect2 = b.get("dock_l", Rect2())
	var tr: Rect2 = b.get("dock_r", Rect2())
	var tb: Rect2 = b.get("dock_down", Rect2())
	var outer := true
	for id in ["fire", "kill", "thrust", "shield", "form", "tractor", "special", "missile1"]:
		if b.has(id) and (b[id] as Rect2).position.x < tl.end.x: outer = false
	for id in ["stop", "warp", "repair", "cloak", "view", "ground", "mine", "missile2"]:
		if b.has(id) and (b[id] as Rect2).end.x > tr.position.x: outer = false
	var big: bool = tl.size.x >= 40.0 and tl.size.y >= 90.0 and tr.size.x >= 40.0 and tb.size.x >= 150.0 and tb.size.y >= 34.0
	var fs_rect: Rect2 = Fs.btn.get_global_rect()
	var fs_ok: bool = Fs.btn.visible and not b.has("fullscreen") and fs_rect.position.x < 20.0 and fs_rect.position.y < 20.0 and fs_rect.size.x >= 48.0
	await _shot("v111_tabs_out", 0.2)
	main._on_hud("dock_l")
	hud._layout()
	var g: Dictionary = hud.dash_geo()
	var tl2: Rect2 = hud.buttons.get("dock_l", Rect2())
	var folds_in: bool = tl2.end.x <= g["rc"].x - g["ro"] + 10.0 and tl2.end.x >= g["rc"].x - g["ro"] - 4.0 and not hud.buttons.has("fire")
	await _shot("v111_left_folded", 0.2)
	main._on_hud("dock_l")
	main._on_hud("dock_down")
	hud._layout()
	var down_ok: bool = not hud.buttons.has("fire") and not hud.buttons.has("warp") and hud.buttons.has("dock_up") and (hud.buttons["dock_up"] as Rect2).size.y >= 34.0
	await _shot("v111_hidden", 0.2)
	main._on_hud("dock_up")
	hud._layout()
	# the small DOCK button: by the station, under the right thumb, not a bar at the top
	var dp: Vector3 = s.dock_point(s.station)
	_tp(dp + (s.station.global_position - dp).normalized() * -20.0, s.station.global_position)
	await _frames(3)
	hud._layout()
	var pr: String = s.prompt()
	var pb: Rect2 = hud.buttons.get(pr, Rect2())
	var small: bool = pr != "" and pb.size.x <= 140.0 and pb.size.y <= 60.0 and pb.position.y > hud.S.y * 0.5
	await _shot("v111_dock_button", 0.2)
	# the jump gate's buttons
	var gd = main.gate_dock
	var ga: StyleBoxFlat = gd.activate_btn.get_theme_stylebox("normal") as StyleBoxFlat
	var gu: StyleBoxFlat = gd.undock_btn.get_theme_stylebox("normal") as StyleBoxFlat
	var gate_ok: bool = ga != null and gu != null and ga.bg_color.g > ga.bg_color.r * 1.5 and gu.bg_color.r > gu.bg_color.g and gu.bg_color.g > gu.bg_color.b
	# the rooms' look sticks: the same drawer as the flight sticks
	var hub_src: String = (main.hub.get_script() as Script).source_code
	var sticks_ok: bool = hub_src.contains("HudStick.draw_stick(") and not hub_src.contains("draw_arc(c, r * 0.5")
	var hb = main.hub
	hb.open(Data.SYSTEMS[s.sys_id]["station"])
	await _frames(2)
	hb.set_panels_hidden(true)
	await _shot("v111_room_sticks", 0.4)
	var fs_room: bool = Fs.btn.visible and Fs.btn.get_global_rect().position.x < 20.0
	hb.set_panels_hidden(false)
	hb.visible = false
	_check("v11.1 (owner): big fold tabs (sides at the far outside of the button blocks, folded = wrapped round the radar's side; a big HIDE tab hides the console), one FULL SCREEN button top-left on every screen, a small DOCK button above the right block, the gate's green ACTIVATE JUMP / orange UNDOCK, the rooms' sticks like flight",
		outer and big and fs_ok and folds_in and down_ok and small and gate_ok and sticks_ok and fs_room,
		"outer %s big %s (l %s r %s b %s) fs %s %s fold %s (%s) down %s dock '%s' %s %s gate %s sticks %s room fs %s" % [outer, big, tl, tr, tb, fs_ok, fs_rect, folds_in, tl2, down_ok, pr, pb, small, gate_ok, sticks_ok, fs_room])

## v11.27 (owner: "something like the ship viewer for the stations, in the command room: rotate it, a light blue screen
## and a magenta one to cut it out, no ring"): the Station Viewer.
func _job_v1127() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	main._load_system("dreadholm", "station")
	await _wait(2.0)
	var hb = main.hub
	var sys0: String = GS.system_id
	GS.system_id = "dreadholm"
	hb.open(Data.SYSTEMS["dreadholm"]["station"])
	await _frames(2)
	hb.show_screen("command")
	await _frames(3)
	var btn: Button = hb.find_child("StationViewerButton", true, false)
	var sv = hb.open_station_viewer()
	await _until(func(): return sv.pivot.get_child_count() > 0 and not sv._loading, 30.0)
	await _frames(4)
	var key: String = sv.keys[sv.idx]
	for bg in [0, 1]:
		sv.bg_mode = bg
		sv._apply_bg()
		for v in ["FRONT", "RIGHT", "TOP", "3/4"]:
			sv.snap(v)
			sv._hide_ui(true)
			await _frames(3)
			await _shot("v1127_%s_%s" % [["blue", "magenta"][bg], v.replace("/", "-")], 0.15)
			sv._hide_ui(false)
	sv.ortho = true
	sv._camera()
	var ortho_ok: bool = sv.cam.projection == Camera3D.PROJECTION_ORTHOGONAL
	await _shot("v1127_ui", 0.2)
	var n0: int = sv.keys.size()
	sv.show_station(sv.idx + 1)
	await _until(func(): return not sv._loading and sv.pivot.get_child_count() > 0, 30.0)
	var next_ok: bool = sv.keys[sv.idx] != key
	var no_ring := true
	for m in sv.vp.find_children("*", "MeshInstance3D", true, false):
		if (m as MeshInstance3D).mesh is TorusMesh: no_ring = false
	sv.queue_free()
	await _frames(2)
	hb.visible = false
	GS.system_id = sys0
	_check("v11.27 (owner): STATION VIEWER in COMMAND: any station on a light-blue / magenta key screen, drag / zoom, FRONT/BACK/LEFT/RIGHT/TOP/BOTTOM/3-4, flat or perspective, hide the buttons, no ring",
		btn != null and key == "st3d_veranthos_summit" and n0 >= 20 and ortho_ok and next_ok and no_ring and Fs.visible,
		"button %s first %s (%d stations) ortho %s next %s no ring %s" % [btn != null, key, n0, ortho_ok, next_ok, no_ring])

## v11.45 (owner: "I want to go inside the battleship as a mech; shoot down the shield tower, fly into the open side
## hangar, fight their mechs three at a time, ten in all, then the boss; grab the bounty; blow the reactor; 90 s out")
func _job_v1145() -> void:
	var res: Array = []
	main._load_system("synthari_capital", "station")
	await _wait(2.0)
	var s := _sp()
	var bs: Dictionary = {}
	for e in s.fleet_patrols:
		if str(e["def"].get("carrier", "")) == "battleship": bs = e
	# v11.55 (owner): no shoot-off parts; the hangar opens only with the shield at 0, and closes when it comes back
	var parts_ok: bool = not bs.is_empty() and bs.get("boardable", false) and (bs.get("parts", []) as Array).is_empty() and is_instance_valid(bs.get("bay_node", null))
	res.append("one shield + hull, no parts %s" % parts_ok)
	if not parts_ok:
		_check("v11.45: boarding", false, " · ".join(res))
		return
	var form_a: String = GS.form
	GS.form = "mech"
	bs["sh"] = float(bs["sh_max"])
	s._board_asked = true   # (only look: no boarding yet)
	s.player.global_position = (bs["bay_node"] as Node3D).global_position + Vector3(0, 0, 30)
	var r0: int = s.board_refused
	s._board_said_t = 0.0
	s._board_asked = false
	await _frames(3)
	var refused: bool = s.board_refused > r0 and not s.boarding and not (bs["bay_node"] as Node3D).visible
	s.player.global_position = (bs["bay_node"] as Node3D).global_position + Vector3(0, 0, 3000)
	bs["sh"] = 0.0
	bs["sh_cd"] = 99.0
	await _frames(3)
	var opened: bool = SpaceSystem.board_open(bs) and (bs["bay_node"] as Node3D).visible
	bs["sh_cd"] = 0.0
	await _wait(1.0)   # (v11.60 owner: once broken the shield stays down, no regen)
	var stays_down: bool = float(bs["sh"]) <= 0.0 and SpaceSystem.board_open(bs) and (bs["bay_node"] as Node3D).visible
	GS.form = form_a
	res.append("refused while shield up %s, open at 0 %s, stays down %s" % [refused, opened, stays_down])
	var shield_ok := refused and opened and stays_down
	var stopped := true
	var silent := true
	# v11.56 (owner): at the open hangar the ship turns into its mech and goes in: 3 rooms (breach hangar, reactor spine,
	# generator core), alarm waves; clear the generator, run back to the hangar, fly out: the battleship is gone, you are paid
	var cr0 := GS.credits
	var st0: float = Factions.standing(str(bs.get("faction", "")))
	GS.form = "ship"
	s._board_said_t = 0.0
	s._board_asked = false
	s.player.global_position = (bs["node"] as Node3D).global_position + Vector3(0, 0, float(bs["def"].get("hit_r", 200.0)) + Data.BOARD_NEAR * 0.5)
	Boarding.classic = true   # v12.18: the walkthrough knows the hand-made battleship's coordinates
	await _frames(3)
	main.hud._layout()
	var board_btn: bool = s.prompt() == "board" and main.hud.buttons.has("board")   # v11.60 (owner): BOARD next to the ship
	res.append("BOARD button %s" % board_btn)
	main._on_hud("board")
	var no_morph: bool = s.transform_t <= 0.0 and main.state == "boarding"   # v12.29 (owner): BOARD just docks: no transforming out in the open
	await _until(func(): return main.state == "flight" and is_instance_valid(main.space) and main.space.boarding, 15.0)
	var went_in: bool = is_instance_valid(main.space) and main.space.boarding and GS.form == "mech" and no_morph
	var rep_hit: bool = Factions.standing(str(bs.get("faction", ""))) < st0 or not Factions.normal(str(bs.get("faction", "")))
	res.append("docked as a ship, mech inside %s, rep down %s" % [went_in, rep_hit])
	var rooms_ok := went_in
	var out_ok := false
	if went_in:
		var wk: Dictionary = await _board_walkthrough()
		rooms_ok = bool(wk["ok"])
		res.append(str(wk["txt"]))
		s = _sp()
		out_ok = main.state == "flight" and not s.boarding and GS.credits >= cr0 + Data.BOARD_PAY and GS.form == "ship" and s.transform_t <= 0.0   # (v12.29: out as the ship you came in, at once)
	res.append("out, wave cleared, paid %s" % out_ok)
	Boarding.classic = false
	if GS.form == "mech": s.start_transform()
	_check("v11.60 (owner): BOARDING a battleship: one shield + hull, no shoot-off parts; SHIELDS UP while its shield is above 0; once broken it stays down; BOARD shows next to the ship; the ship turns into its mech and goes in (v11.70: the corridor run, the core, the other exit, the wave outside, then paid); infiltrating costs standing",
		parts_ok and shield_ok and board_btn and went_in and rep_hit and rooms_ok and out_ok, " · ".join(res))

## v11.32 (owner: "the battleships were a success ... name them, put them in the game, where they need to go, put
## those little ships for sale as faction fighters"): every fleet model is real and nose-first; a capital has its fleet
## out round the station; an invasion brings the faction's own battleship; the starfighters are in the SHIPYARD.
func _job_v1132() -> void:
	var res: Array = []
	var missing: Array = []
	var bad_len: Array = []
	for f in Data.FACTION_FLEET:
		for role in ["battleship", "cruiser", "frigate", "starfighter"]:
			var k: String = Data.FACTION_FLEET[f][role]
			if k == "": continue
			if not ShipFactory.has_real_model(k):
				missing.append(k)
				continue
			var m := ShipFactory.build(k)
			var box := AABB(); var first := true
			for mi in m.find_children("*", "MeshInstance3D", true, false):
				var b: AABB = (mi as MeshInstance3D).transform * (mi as MeshInstance3D).get_aabb()
				var par := (mi as Node3D).get_parent() as Node3D
				while par != null and par != m:
					b = par.transform * b
					par = par.get_parent() as Node3D
				box = b if first else box.merge(b)
				first = false
			var want: float = ShipFactory.GLB[k][1]
			if absf(box.size.z - want) > want * 0.08 or box.size.z < box.size.x * 0.9: bad_len.append("%s %.0fx%.0f" % [k, box.size.x, box.size.z])
			m.free()
	res.append("missing %s long-way %s" % [missing, bad_len])
	# v11.38: the patrols: the faction's battleship and cruiser out in its systems, peaceful until you shoot (or your standing is bad)
	main._load_system("aurelion", "station")
	await _wait(2.0)
	var s := _sp()
	var names: Array = s.fleet_patrols.map(func(e): return str(e["node"].name))
	var n_bs: int = names.filter(func(n): return str(n).begins_with("Elyza Battleship")).size()   # v11.87: the home system has 3 battleships
	var guard_ok: bool = s.fleet_patrols.size() == Data.HOME_BATTLESHIPS + 1 and n_bs == Data.HOME_BATTLESHIPS and names.has("Elyza Cruiser") and s.fleet_guard.is_empty()
	var bs: Node3D = s.fleet_patrols[0]["node"] if not s.fleet_patrols.is_empty() else null
	var moved := false
	var peace_ok := false
	if bs != null:
		var be: Dictionary = s.fleet_patrols[0]
		var p0: Vector3 = bs.global_position
		await _wait(1.5)
		moved = bs.global_position.distance_to(p0) > 3.0
		var info: Dictionary = s.scan_info(bs)
		guard_ok = guard_ok and not info.is_empty()
		# peaceful: no launches, no "enemy" contact, while you are near and on good terms
		s.player.global_position = bs.global_position + Vector3(0, 300, 1200)
		var l0: int = s.carrier_launches
		for i in 10: s._update_carriers(2.0)
		await _frames(2)
		var calm: bool = s.carrier_launches == l0 and s.fleet_peaceful(be) and bs.get_meta("kind", "") == "patrol"
		# shoot it: it turns hostile and the hangar opens (15 out at most)
		s._damage_enemy(be, 5.0)
		for i in 40: s._update_carriers(2.0)
		await _frames(2)
		var angry: bool = not s.fleet_peaceful(be) and bs.get_meta("kind", "") == "enemy" and s.carrier_launches - l0 == 15
		# the cruiser: 5 out at a time
		var ce: Dictionary = s.fleet_patrols[1]
		s.player.global_position = ce["node"].global_position + Vector3(0, 200, 900)
		var l1: int = s.carrier_launches
		s._damage_enemy(ce, 5.0)
		for i in 40: s._update_carriers(2.0)
		var cr_ok: bool = s.carrier_launches - l1 == 5 and s.hangar_left(ce) == 25
		# v11.39: no threat (you flew off): the fighters turn for home and land, back in the hangar
		s.player.global_position = bs.global_position + Vector3(0, 0, 12000)
		s._update_carriers(0.1)
		var bc: Dictionary = {}
		for c in s.carriers:
			if c["ent"] == be: bc = c
		var nk: int = (bc.get("kids", []) as Array).size()
		var left0: int = s.hangar_left(be)
		var turning: bool = nk > 0 and (bc["kids"] as Array).all(func(k): return k.get("recall", false))
		var ld0: int = s.carrier_landed
		for k in bc.get("kids", []): k["node"].global_position = bs.global_position + Vector3(0, 20, 0)
		s._update_carriers(0.1)
		var home_ok: bool = turning and s.carrier_landed - ld0 == nk and s.hangar_left(be) == left0 + nk and (bc["kids"] as Array).is_empty()
		peace_ok = calm and angry and cr_ok and home_ok
		res.append("peace %s angry %s cruiser %s home %s (turn %s landed %d left %d)" % [calm, angry, cr_ok, home_ok, turning, s.carrier_landed - ld0, s.hangar_left(be)])
		s.process_mode = Node.PROCESS_MODE_DISABLED   # (hold the camera on it for the picture)
		main.hud.visible = false
		var mid: Vector3 = bs.global_position
		s.cam.global_position = mid + Vector3(500, 120, 500)
		s.cam.look_at(mid, Vector3.UP)
		await _frames(3)
		await _shot("v1132_elyza_patrol", 0.2)
		main.hud.visible = true
		s.process_mode = Node.PROCESS_MODE_INHERIT
		for c in s.carriers.duplicate():
			for k in (c["kids"] as Array).duplicate():
				if s.enemies.has(k): s._destroy_unit(k)
	guard_ok = guard_ok and peace_ok
	res.append("patrol %s %s moved %s" % [guard_ok, names, moved])
	# v11.41: rival battleships that see each other fight (only while you are near enough to see it)
	var clash_ok := false
	main._load_system("crystara", "station")
	await _wait(2.0)
	s = _sp()
	for e in s.fleet_patrols.duplicate():
		if s.enemies.has(e):
			s.enemies.erase(e)
			e["node"].queue_free()
	s.carriers.clear()
	s.force_clash = true
	s._fleet_patrols()
	var raid: Array = s.fleet_patrols.filter(func(e): return e.get("raider", false))
	if raid.size() == 1:
		var hb: Dictionary = s.fleet_patrols[0]
		var rb: Dictionary = raid[0]
		var far: Vector3 = hb["node"].global_position + Vector3(0, 0, 30000)
		s.player.global_position = far
		rb["node"].global_position = hb["node"].global_position + Vector3(3500, 0, 0)
		s._update_clash()
		var unseen: bool = s.clash_log.is_empty()   # (you are not there: nothing happens)
		s.player.global_position = hb["node"].global_position + Vector3(1700, 400, 2500)
		s._update_clash()
		var seen: bool = s.clash_log.has("seen") and hb.get("war_foe", {}) == rb
		for i in 40: s._update_carriers(2.0)
		var both_out: int = 0
		for c in s.carriers: both_out += (c["kids"] as Array).filter(func(k): return k.get("war", false)).size()
		var sh0: float = float(rb["sh"]) + float(rb["hp"])
		await _wait(4.0)
		var hurt: bool = float(rb["sh"]) + float(rb["hp"]) < sh0
		s.process_mode = Node.PROCESS_MODE_DISABLED
		main.hud.visible = false
		var mid: Vector3 = (hb["node"].global_position + rb["node"].global_position) * 0.5
		s.cam.global_position = mid + Vector3(0, 700, 2600)
		s.cam.look_at(mid, Vector3.UP)
		await _frames(3)
		await _shot("v1141_fleet_battle", 0.2)
		main.hud.visible = true
		s.process_mode = Node.PROCESS_MODE_INHERIT
		# you fly off: it holds still, the fighters head home
		s.player.global_position = far
		await _frames(2)
		var hp1: float = float(rb["hp"])
		await _wait(1.0)
		var still: bool = absf(float(rb["hp"]) - hp1) < 0.01   # (no damage out of your sight)
		var homing := true
		for c in s.carriers:
			for k in c["kids"]: homing = homing and k.get("recall", false)
		clash_ok = unseen and seen and both_out == 30 and hurt and homing and still
		res.append("clash unseen %s seen %s out %d hurt %s home %s still %s" % [unseen, seen, both_out, hurt, homing, still])
		for e in s.enemies.duplicate():
			if e.get("fleet_patrol", false) or e.get("war", false):
				s.enemies.erase(e)
				e["node"].queue_free()
		s.carriers.clear()
	else: res.append("clash: no raider")
	main._load_system("aurelion", "station")
	await _wait(2.0)
	s = _sp()
	# an Imperium invasion brings its own battleship
	var inv_ok := false
	s.spawn_invasion(s.player.global_position - s.player.global_basis.z * 900.0, "Imperium", 1, false)
	await _frames(3)
	for e in s.invasion_units("battleship"):
		if str(e.get("model_key", "")) == "imperium_battleship" or e["node"].find_child("Model_imperium_battleship", true, false) != null: inv_ok = true
	res.append("invasion %s" % inv_ok)
	# v11.33: the battleship's hangar: 15 out at a time, 90 in all, then none; 35 nukes destroy it
	var bse: Dictionary = {}
	for e in s.invasion_units("battleship"): bse = e
	var hang_ok := false
	var nuke_ok := false
	if not bse.is_empty():
		s.process_mode = Node.PROCESS_MODE_DISABLED   # (no fighting while counting)
		bse["node"].global_position = s.player.global_position - s.player.global_basis.z * 2500.0
		for i in 40: s._update_carriers(2.0)
		var first_out: int = 90 - s.hangar_left(bse)
		var total := first_out
		for round_i in 12:   # shoot down what is out, let more come
			for c in s.carriers:
				if c["ent"] == bse:
					for k in (c["kids"] as Array).duplicate(): s._destroy_unit(k)
			for i in 40: s._update_carriers(2.0)
			total = 90 - s.hangar_left(bse)
		hang_ok = first_out == 15 and total == 90 and s.hangar_left(bse) == 0
		res.append("hangar first %d total %d left %d" % [first_out, total, s.hangar_left(bse)])
		# v11.37: solid: flown into the middle, you are pushed out of its hull
		var b0: int = s.ship_bumps
		var pp0: Vector3 = s.player.global_position
		s.player.global_position = bse["node"].global_position + Vector3(0, 2, 0)
		s._bump_ships()
		var out_d: float = s.player.global_position.distance_to(bse["node"].global_position)
		var solid_ok: bool = s.ship_bumps > b0 and out_d > 15.0 and bse["node"].has_meta("ship_box")
		s.player.global_position = pp0
		res.append("solid %s (pushed %.0f m)" % [solid_ok, out_d])
		var hits := 0
		while s.enemies.has(bse) and hits < 60:
			s._damage_enemy(bse, s.fleet_nuke_damage(bse))
			hits += 1
		nuke_ok = hits == Data.FLEET_NUKES_TO_KILL["battleship"] and GS.max_nukes() == 50 and GS.max_mines() >= 50 and solid_ok
		res.append("nukes %d" % hits)
		s.process_mode = Node.PROCESS_MODE_INHERIT
	for e in s.invasion_units(""): s._destroy_unit(e)
	for a in s.allies:
		if is_instance_valid(a["node"]): a["node"].queue_free()
	s.allies = []
	# the SHIPYARD sells them
	var sale_ok: bool = Data.FLEET_FIGHTERS_FOR_SALE.size() == 8
	for k in Data.FLEET_FIGHTERS_FOR_SALE: sale_ok = sale_ok and k in Data.SHIP_ORDER and Data.SHIPS.has(k) and ShipFactory.has_real_model(str(Data.SHIPS[k]["model"]))
