## v11.28 (owner: "do it for the ship scan ... the pinch view for anything you scan: ships, stations, buildings, mechs"):
## scan an enemy and the station; 3D VIEW opens the viewer on a copy of each; the flight holds still; CLOSE gives it back.
func _job_v1128() -> void:
	main._load_system("dreadholm", "station")
	await _wait(2.0)
	var s = _sp()
	var hud = main.hud
	var res: Array = []
	# 1) an enemy ship right in front
	var g: Array = s.spawn_mission_group(s.player.global_position - s.player.global_basis.z * 300.0, "Savagers", 1, 3, "", 7)
	var n: Node3D = g[0]["node"] if not g.is_empty() else null
	if not g.is_empty():
		g[0]["hp"] = 1.0e6   # (the auto-guns fire at it: keep it alive)
		g[0]["max"] = 1.0e6
	var ship_ok := false
	var copy_n := 0
	if n != null:
		n.global_position = s.player.global_position - s.player.global_basis.z * 300.0
		s.target = n
		hud.close_scan()
		hud.start_scan()
		await _wait(Data.SCAN_TIME + 0.4)
		var btn_ok: bool = hud.button_at(hud.scan_view_rect().get_center()) == "scan_view"
		var sv: StationViewer = main.open_scan_view()
		await _frames(4)
		if sv != null:
			copy_n = sv.pivot.find_children("*", "MeshInstance3D", true, false).size()
			ship_ok = btn_ok and sv.single and copy_n > 0 and s.process_mode == Node.PROCESS_MODE_DISABLED and not hud.visible
			sv._hide_ui(true)
			await _frames(2)
			await _shot("v1128_ship_blue", 0.2)
			sv.bg_mode = 1; sv._apply_bg(); sv.snap("FRONT")
			await _frames(2)
			await _shot("v1128_ship_magenta_front", 0.2)
			sv._hide_ui(false)
			await _frames(2)
			await _shot("v1128_ship_ui", 0.2)
			sv.queue_free()
			await _frames(3)
	var back_ok: bool = hud.visible and s.process_mode != Node.PROCESS_MODE_DISABLED and not main.controls.blocked
	res.append("ship %s (%d meshes) back %s" % [ship_ok, copy_n, back_ok])
	for e in g:
		if e in s.enemies: s._destroy_unit(e)
	await _frames(2)
	# 2) the station: scans as a structure, opens on its own model
	s.player.global_position = s.station.global_position + Vector3(0, 0, 900)
	s.target = s.station
	hud.close_scan()
	var said: String = hud.start_scan()
	await _wait(0.3)
	said += " tgt=%s node=%s" % [s.target.name if s.target else "null", hud.scan_node.name if hud.scan_node else "null"]
	await _wait(Data.SCAN_TIME + 0.1)
	var st_ok := false
	var sv2: StationViewer = main.open_scan_view()
	await _frames(4)
	if sv2 != null:
		var k: String = sv2.keys[sv2.idx] if not sv2.single else ""
		st_ok = k == "st3d_veranthos_summit"
		var t0 := Time.get_ticks_msec()
		while sv2.pivot.get_child_count() == 0 and Time.get_ticks_msec() - t0 < 20000: await _frames(2)
		sv2._hide_ui(true)
		await _frames(3)
		await _shot("v1128_station", 0.2)
		sv2.queue_free()
		await _frames(3)
	res.append("station %s (%s) scan %s key '%s' sv %s" % [st_ok, said, not hud.scan.is_empty(), s.scan_model_key(s.station), sv2 != null])
	s.target = null
	hud.close_scan()
	_check("v11.28 (owner): SCAN any ship, mech or station, then 3D VIEW opens it in the viewer (rotate, zoom, key screens); the flight holds still and comes back on CLOSE",
		ship_ok and back_ok and st_ok and hud.visible, " · ".join(res))


## v11 (owner: "I can't dock at the station"; "the close trade lanes pull together at the entrance"): next to any side
## of a (now twice as big) station's hull you can dock; the trade-lane mouths round a station sit clear of its hull and
## never inside each other's rings.
func _job_v11() -> void:
	var s := _sp()
	if s.surface_mode or main.state != "flight": return
	var sys0: String = s.sys_id
	main._load_system("vantara", "station")   # (the owner's shot: Resistance Headquarters, a 3D station)
	await _wait(2.0)
	s = _sp()
	await _until(func(): return s.station.has_meta("box_aabb"), 20.0)
	var dock_ok := false
	var note := ""
	if s.station.has_meta("box_aabb"):
		var hd: Node3D = s.station.get_meta("box_holder")
		var bb: AABB = s.station.get_meta("box_aabb")
		var side: Vector3 = hd.global_transform * Vector3(bb.end.x, bb.get_center().y, bb.get_center().z)
		var out: Vector3 = (side - s.station.global_position); out.y = 0.0
		var at: Vector3 = side + out.normalized() * 120.0
		_tp(at, s.station.global_position)
		await _frames(2)
		var far_c: bool = at.distance_to(s.station.global_position) > Data.DOCK_RANGE_STATION and at.distance_to(s.dock_point(s.station)) > Data.DOCK_RANGE_STATION
		dock_ok = s.dock_candidate() == s.station
		note = "beside the hull (%.0f m from its middle, hull %.0f m): %s" % [at.distance_to(s.station.global_position), s.hull_distance(s.station), dock_ok]
		if not far_c: note += " (the old rule would have allowed it too)"
	var mouths: Array = []
	for ln in s.lanes:
		if str(ln["a"]) == s.station.name: mouths.append([ln["up"][0], ln["down"][0]])
	var apart := true
	for i in mouths.size():
		for j in range(i + 1, mouths.size()):
			for a in mouths[i]:
				for b in mouths[j]:
					if (a as Vector3).distance_to(b) < Data.LANE_RING_RADIUS * 2.3: apart = false
	var clear_hull := true
	for m in mouths:
		if (m[0] as Vector3).distance_to(s.station.global_position) < s._station_reach(): clear_hull = false
	main._load_system(sys0, "station")
	await _wait(1.6)
	_check("v11 (owner): you can dock beside any side of a station's hull (stations are twice the size), and the trade-lane mouths round a station are clear of its hull and of each other's rings",
		dock_ok and apart and clear_hull, "%s; %d mouths apart %s, clear of hull %s" % [note, mouths.size(), apart, clear_hull])

